---
import '../styles/global.css';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import { business } from '../data/business';

interface Props {
  /** Seitentitel ohne Markenname, wird zu „Titel | Nang Thai Massage“ */
  title: string;
  /** Vollständiger Titel, falls die Standardform nicht passt */
  fullTitle?: string;
  description: string;
  /** Brotkrumen für die strukturierten Daten, ohne Startseite */
  breadcrumbs?: { name: string; href: string }[];
  /** Zusätzliche JSON-LD-Objekte */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Sprache der Seite; „de“ steht in der Feedback-Version für die thailändische Übersetzung */
  lang?: 'de' | 'en';
  /** Sprachversionen derselben Seite für hreflang */
  alternates?: { hreflang: string; href: string }[];
}

// Feedback-Version: breadcrumbs, schema, noindex und alternates werden bewusst nicht ausgegeben
// (keine strukturierten Daten, keine Canonical- oder hreflang-Verweise, immer noindex).
const { title, fullTitle, description, lang = 'de' } = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
// Feedback-Version: Titel markieren, damit niemand sie mit der echten Seite verwechselt
const pageTitle = `[ฉบับตรวจทาน] ${fullTitle ?? `${title} | ${business.name}`}`;
const ogImage = new URL('/og-image.jpg', site).href;
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'th'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {/* Feedback-Version: nie in Suchmaschinen, keine Verweise auf die echte Domain */}
    <meta name="robots" content="noindex, nofollow" />

    <Fonts />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2a165c" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'th_TH'} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${business.name} – Thaimassage in ${business.address.city}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="geo.region" content="DE-BW" />
    <meta name="geo.placename" content={business.address.city} />

  </head>
  <body>
    <a class="skip-link" href="#inhalt">{lang === 'en' ? 'Skip to content' : 'ข้ามไปยังเนื้อหา'}</a>
    <aside class="feedback-banner" lang="th" aria-label="ฉบับตรวจทาน">
      <p>
        <strong>ฉบับแปลภาษาไทยสำหรับตรวจทานเท่านั้น</strong>
        {' ไม่ใช่เว็บไซต์จริง เว็บไซต์จริงเป็นภาษาเยอรมันที่ nang-thaimassage-ehningen.de'}
        <span lang="de">Thailändische Feedback-Version, nicht die offizielle Website</span>
      </p>
    </aside>
    <Header lang={lang} />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <MobileCallBar lang={lang} />
  </body>
</html>
