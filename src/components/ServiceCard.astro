---
import Icon from './Icon.astro';
import { type Service, formatPrice, formatMinutes } from '../data/services';

interface Props {
  service: Service;
  headingLevel?: 'h2' | 'h3';
}

const { service, headingLevel: Heading = 'h3' } = Astro.props;
---

<article class="service-card">
  <Heading class="service-card__title">
    <a href={`/leistungen/${service.slug}/`}>{service.name}</a>
  </Heading>
  <p class="service-card__teaser">{service.teaser}</p>
  <dl class="service-card__prices">
    {
      service.options.map((o) => (
        <div>
          <dt>{formatMinutes(o.minutes)}</dt>
          <dd>{formatPrice(o.price)}</dd>
        </div>
      ))
    }
  </dl>
  <span class="service-card__more" aria-hidden="true">Details <Icon name="arrow-right" /></span>
</article>

<style>
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.75rem 1.5rem 1.4rem;
    border: 1px solid var(--cream-300);
    border-top: 3px solid var(--gold-500);
    border-radius: var(--radius);
    background: var(--cream-50);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .service-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .service-card__title {
    margin-bottom: 0.5rem;
    font-size: 1.6rem;
  }

  .service-card__title a {
    color: inherit;
    text-decoration: none;
  }

  /* Ganze Karte klickbar */
  .service-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .service-card__title a:focus-visible {
    outline: none;
  }

  .service-card:has(a:focus-visible) {
    outline: 3px solid var(--gold-500);
    outline-offset: 3px;
  }

  .service-card__teaser {
    color: var(--ink-700);
  }

  .service-card__prices {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5.5rem, 1fr));
    gap: 0.5rem;
    margin: auto 0 1.1rem;
    padding-top: 0.5rem;
  }

  .service-card__prices div {
    padding: 0.45rem 0.5rem;
    border-radius: var(--radius-sm);
    background: var(--purple-100);
    text-align: center;
  }

  .service-card__prices dt {
    font-size: 0.875rem;
    color: var(--ink-500);
  }

  .service-card__prices dd {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--purple-700);
  }

  .service-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 650;
    color: var(--purple-600);
  }

  .service-card__more :global(.icon) {
    width: 1rem;
    height: 1rem;
    transition: transform 0.2s ease;
  }

  .service-card:hover .service-card__more :global(.icon) {
    transform: translateX(3px);
  }
</style>
