---
/**
 * Google-Maps-Karte mit Zwei-Klick-Lösung: Erst nach Klick auf „Karte laden“
 * wird eine Verbindung zu Google aufgebaut (Einwilligung nach § 25 TDDDG,
 * Art. 6 Abs. 1 lit. a DSGVO).
 */
import Icon from './Icon.astro';
import { business, fullAddress } from '../data/business';
import { mapEmbedUrl, directionsUrl } from '../lib/links';
---

<div class="map" data-map-embed>
  <div class="map__placeholder bg-damask-light">
    <Icon name="map-pin" class="map__pin" />
    <p class="map__address"><strong>{business.name}</strong><br />{fullAddress}</p>
    <button type="button" class="btn btn--purple" data-map-load>Karte von Google Maps laden</button>
    <p class="map__hint">
      Beim Laden der Karte werden Daten, zum Beispiel Ihre IP-Adresse, an Google übertragen. Mehr dazu in der{' '}
      <a href="/datenschutz/#google-maps">Datenschutzerklärung</a>.
    </p>
    <a class="text-link" href={directionsUrl} rel="noopener" target="_blank">Route direkt in Google Maps öffnen <Icon name="arrow-right" /></a>
  </div>
  <template data-map-template>
    <iframe
      src={mapEmbedUrl}
      title={`Karte: ${business.name}, ${fullAddress}`}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen></iframe>
  </template>
</div>

<script>
  for (const embed of document.querySelectorAll<HTMLElement>('[data-map-embed]')) {
    const button = embed.querySelector<HTMLButtonElement>('[data-map-load]');
    const template = embed.querySelector<HTMLTemplateElement>('[data-map-template]');
    button?.addEventListener('click', () => {
      if (!template) return;
      embed.replaceChildren(template.content.cloneNode(true));
      embed.classList.add('map--loaded');
      embed.querySelector('iframe')?.focus();
    });
  }
</script>

<style>
  .map {
    position: relative;
    overflow: hidden;
    min-height: 24rem;
    border: 1px solid var(--cream-300);
    border-radius: var(--radius-lg);
    background: var(--cream-50);
    box-shadow: var(--shadow-sm);
  }

  .map :global(iframe) {
    display: block;
    width: 100%;
    height: 28rem;
    border: 0;
  }

  .map__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-height: 24rem;
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .map__placeholder :global(.map__pin) {
    width: 2.5rem;
    height: 2.5rem;
    color: var(--gold-600);
  }

  .map__address {
    margin: 0;
    color: var(--purple-800);
  }

  .map__hint {
    max-width: 32rem;
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-500);
  }
</style>
