---
/**
 * Echte Google-Bewertungen (aus src/data/reviews.ts). Ohne Einträge wird nichts ausgegeben.
 * Der Hinweis darunter legt Auswahl, Stand und Kürzungen offen und sagt, wie die Echtheit
 * gesichert ist (§ 5b Abs. 3 UWG): Nang kennt alle Verfasser persönlich als ihre Gäste.
 * Keine strukturierten Daten (Review-Schema): Google wertet eigene Bewertungen eines
 * Unternehmens nicht aus.
 */
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { reviews, reviewsAsOf } from '../data/reviews';
import { googleMapsUrl } from '../lib/links';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{
  reviews.length > 0 && (
    <section class:list={['section', 'reviews', className]} aria-labelledby="bewertungen-title">
      <div class="container">
        <SectionHeading id="bewertungen-title" eyebrow="Bewertungen" title="Was Gäste über Nang schreiben" />
        <ul class="reviews__list">
          {reviews.map((review) => (
            <li>
              <figure>
                <span class="reviews__stars">
                  {[1, 2, 3, 4, 5].map((n) => (
                    <Icon name="star" class={n <= review.rating ? 'reviews__star--full' : undefined} />
                  ))}
                  <span class="visually-hidden">{`${review.rating} von 5 Sternen`}</span>
                </span>
                <blockquote>
                  <p>{`„${review.text}“`}</p>
                </blockquote>
                <figcaption>{`${review.author}, Google-Bewertung`}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <p class="reviews__note">
          {`Auswahl aus den Google-Bewertungen von Nang Thai Massage (Stand: ${reviewsAsOf}), wörtlich übernommen; Kürzungen sind mit […] gekennzeichnet. Alle hier gezeigten Bewertungen stammen von Gästen, die Nang persönlich kennt.`}
        </p>
        <p class="reviews__more">
          <a class="text-link" href={googleMapsUrl} rel="noopener" target="_blank">
            Alle Bewertungen auf Google <Icon name="arrow-right" />
          </a>
        </p>
      </div>
    </section>
  )
}

<style>
  .reviews__list {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .reviews__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .reviews__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .reviews__list figure {
    height: 100%;
    margin: 0;
    padding: 1.5rem;
    border: 1px solid var(--cream-300);
    border-top: 3px solid var(--gold-500);
    border-radius: var(--radius);
    background: var(--cream-50);
    box-shadow: var(--shadow-sm);
  }

  .reviews__stars {
    display: flex;
    gap: 0.15rem;
    color: var(--gold-500);
  }

  .reviews__stars :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .reviews__stars :global(.reviews__star--full) {
    fill: currentColor;
  }

  blockquote {
    margin: 0.75rem 0;
    color: var(--ink-700);
  }

  blockquote p {
    margin: 0;
  }

  figcaption {
    font-weight: 650;
    font-size: 0.9375rem;
    color: var(--purple-800);
  }

  .reviews__note {
    max-width: 46rem;
    margin: 1.75rem auto 0;
    font-size: 0.875rem;
    text-align: center;
    color: var(--ink-500);
  }

  .reviews__more {
    margin: 1rem 0 0;
    text-align: center;
  }
</style>
