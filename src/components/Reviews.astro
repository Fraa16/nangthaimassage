---
/** Echte Google-Bewertungen (aus src/data/reviews.ts). Ohne Einträge wird nichts ausgegeben. */
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { reviews } from '../data/reviews';
import { googleMapsUrl } from '../lib/links';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{
  reviews.length > 0 && (
    <section class:list={['section', 'reviews', className]} aria-labelledby="bewertungen-title">
      <div class="container">
        <SectionHeading id="bewertungen-title" eyebrow="Bewertungen" title="Was Gäste über Nang schreiben" />
        <ul class="reviews__list">
          {reviews.map((review) => (
            <li>
              <figure>
                <span class="reviews__stars" aria-hidden="true">
                  <Icon name="star" />
                  <Icon name="star" />
                  <Icon name="star" />
                  <Icon name="star" />
                  <Icon name="star" />
                </span>
                <blockquote>
                  <p>{`„${review.text}“`}</p>
                </blockquote>
                <figcaption>{`${review.author}, Google-Bewertung`}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <p class="reviews__more">
          <a class="text-link" href={googleMapsUrl} rel="noopener" target="_blank">
            Alle Bewertungen auf Google <Icon name="arrow-right" />
          </a>
        </p>
      </div>
    </section>
  )
}

<style>
  .reviews__list {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .reviews__list {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
  }

  .reviews__list figure {
    height: 100%;
    margin: 0;
    padding: 1.5rem;
    border: 1px solid var(--cream-300);
    border-top: 3px solid var(--gold-500);
    border-radius: var(--radius);
    background: var(--cream-50);
    box-shadow: var(--shadow-sm);
  }

  .reviews__stars {
    display: flex;
    gap: 0.15rem;
    color: var(--gold-500);
  }

  .reviews__stars :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }

  blockquote {
    margin: 0.75rem 0;
    color: var(--ink-700);
  }

  blockquote p {
    margin: 0;
  }

  figcaption {
    font-weight: 650;
    font-size: 0.9375rem;
    color: var(--purple-800);
  }

  .reviews__more {
    margin: 2rem 0 0;
    text-align: center;
  }
</style>
