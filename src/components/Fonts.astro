---
/**
 * Schriften liegen auf dem eigenen Server (keine Verbindung zu Google Fonts,
 * DSGVO). Nur der lateinische Zeichensatz wird geladen; die zwei Schriften
 * für den ersten Bildschirm werden vorgeladen.
 */
import sourceSans from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import cormorant600 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-normal.woff2?url';
import cormorant600Italic from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-italic.woff2?url';
import cormorant700 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-700-normal.woff2?url';
import cinzel600 from '@fontsource/cinzel/files/cinzel-latin-600-normal.woff2?url';

const latin =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';

const css = `
@font-face{font-family:'Source Sans 3 Variable';font-style:normal;font-display:swap;font-weight:200 900;src:url(${sourceSans}) format('woff2-variations'),url(${sourceSans}) format('woff2');unicode-range:${latin}}
@font-face{font-family:'Cormorant Garamond';font-style:normal;font-display:swap;font-weight:600;src:url(${cormorant600}) format('woff2');unicode-range:${latin}}
@font-face{font-family:'Cormorant Garamond';font-style:italic;font-display:swap;font-weight:600;src:url(${cormorant600Italic}) format('woff2');unicode-range:${latin}}
@font-face{font-family:'Cormorant Garamond';font-style:normal;font-display:swap;font-weight:700;src:url(${cormorant700}) format('woff2');unicode-range:${latin}}
@font-face{font-family:'Cinzel';font-style:normal;font-display:swap;font-weight:600;src:url(${cinzel600}) format('woff2');unicode-range:${latin}}
`;
---

<link rel="preload" href={sourceSans} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={cormorant600} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={css}></style>
