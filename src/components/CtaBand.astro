---
import Icon from './Icon.astro';
import Ornament from './Ornament.astro';
import LatticeBand from './LatticeBand.astro';
import { business, hoursSummary } from '../data/business';
import { telHref, whatsappHref } from '../lib/links';

interface Props {
  title?: string;
  text?: string;
}

const hours = hoursSummary();
const {
  title = 'นัดเวลาได้ง่าย ๆ แค่โทรมา',
  text = `${hours ? `เปิด${hours} รวมถึงวันเสาร์ วันอาทิตย์ และวันหยุดนักขัตฤกษ์` : ''} โทรหรือส่งข้อความ WhatsApp มาได้เลย เราจะหาเวลาที่เหมาะกับคุณ`,
} = Astro.props;
---

<LatticeBand />
<section class="cta-band bg-damask">
  <div class="container cta-band__inner">
    <Ornament size={40} />
    <h2>{title}</h2>
    <p class="lead">{text.trim()}</p>
    <div class="btn-row">
      <a class="btn btn--gold" href={telHref}><Icon name="phone" /> โทร {business.phone.display}</a>
      <a class="btn btn--outline-light" href={whatsappHref('Hallo, ich möchte gern einen Termin vereinbaren.')} rel="noopener" target="_blank">
        <Icon name="whatsapp" /> สอบถามทาง WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: clamp(3rem, 7vw, 5rem);
    text-align: center;
  }

  .cta-band__inner {
    max-width: calc(44rem + 2 * var(--gutter));
  }

  .cta-band h2 {
    margin-top: 1rem;
  }

  .cta-band .btn-row {
    justify-content: center;
    margin-top: 1.75rem;
  }
</style>
