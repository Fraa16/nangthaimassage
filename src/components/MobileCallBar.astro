---
/** Feste Aktionsleiste am unteren Rand, nur auf dem Smartphone. */
import Icon from './Icon.astro';
import { telHref, whatsappHref, directionsUrl } from '../lib/links';

interface Props {
  lang?: 'de' | 'en';
}

const { lang = 'de' } = Astro.props;
const t =
  lang === 'en'
    ? { nav: 'Quick contact', call: 'Call', route: 'Directions', message: 'Hello, I would like to book a massage appointment.' }
    : { nav: 'Schnellkontakt', call: 'Anrufen', route: 'Route', message: 'Hallo, ich möchte gern einen Termin vereinbaren.' };
---

<nav class="call-bar" aria-label={t.nav}>
  <a href={telHref}>
    <Icon name="phone" />
    <span>{t.call}</span>
  </a>
  <a href={whatsappHref(t.message)} rel="noopener" target="_blank">
    <Icon name="whatsapp" />
    <span>WhatsApp</span>
  </a>
  <a href={directionsUrl} rel="noopener" target="_blank">
    <Icon name="route" />
    <span>{t.route}</span>
  </a>
</nav>

<style>
  .call-bar {
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    height: calc(var(--mobile-bar-h) + env(safe-area-inset-bottom, 0px));
    padding-bottom: env(safe-area-inset-bottom, 0px);
    background: var(--purple-900);
    border-top: 2px solid var(--gold-500);
    box-shadow: 0 -8px 24px -12px rgb(20 10 44 / 0.7);
  }

  @media (min-width: 48rem) {
    .call-bar {
      display: none;
    }
  }

  .call-bar a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    color: var(--cream-50);
    font-size: 0.875rem;
    font-weight: 650;
    text-decoration: none;
  }

  .call-bar a + a {
    border-left: 1px solid rgb(247 215 116 / 0.2);
  }

  .call-bar a:first-child {
    background: var(--gold-gradient);
    color: var(--purple-900);
  }

  .call-bar :global(.icon) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .call-bar :global(.icon-whatsapp) {
    color: #4ade80;
  }
</style>
