---
/** Tafel im Stil des Schilds: Jahre Erfahrung und Schwerpunkte. */
import Ornament from './Ornament.astro';
import { about, yearsOfExperience } from '../data/about';
---

<aside class="badge" aria-label="Nangs Erfahrung und Schwerpunkt">
  <Ornament size={44} lines={false} />
  <p class="badge__years">
    <span class="badge__number">{yearsOfExperience}</span>
    <span class="badge__label">Jahre Erfahrung</span>
  </p>
  <p class="badge__title">Schwerpunkt</p>
  <ul class="badge__areas">
    {about.focusAreas.map((area) => <li>{area}</li>)}
  </ul>
</aside>

<style>
  .badge {
    padding: 2rem 1.5rem 1.75rem;
    border: 6px solid var(--purple-700);
    border-radius: 6px;
    outline: 2px solid var(--gold-500);
    outline-offset: -12px;
    background: var(--cream-50);
    box-shadow: var(--shadow);
    text-align: center;
  }

  .badge__years {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0.5rem 0 1.25rem;
  }

  .badge__number {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 3.5rem + 4vw, 6.5rem);
    font-weight: 700;
    line-height: 0.95;
    font-variant-numeric: lining-nums;
    background: linear-gradient(180deg, #f2c85a 0%, #c38b1d 55%, #8f6412 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .badge__label,
  .badge__title {
    font-family: var(--font-caps);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .badge__label {
    font-size: 0.9375rem;
    color: var(--purple-800);
  }

  .badge__title {
    margin: 0 0 0.6rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--cream-300);
    font-size: 0.75rem;
    color: var(--gold-700);
  }

  .badge__areas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .badge__areas li {
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: var(--purple-100);
    font-weight: 650;
    font-size: 0.9375rem;
    color: var(--purple-800);
  }
</style>
