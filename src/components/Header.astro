---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { mainNav, mainNavEn, isCurrent } from '../data/navigation';
import { business, hoursSummary, hoursSummaryEn } from '../data/business';
import { telHref, whatsappHref } from '../lib/links';

interface Props {
  lang?: 'de' | 'en';
}

const { lang = 'de' } = Astro.props;
const path = Astro.url.pathname;
const en = lang === 'en';
const nav = en ? mainNavEn : mainNav;
const hours = en ? hoursSummaryEn() : hoursSummary();
const t = en
  ? {
      home: '/en/',
      homeLabel: `${business.name} – home`,
      nav: 'Main navigation',
      navMobile: 'Main navigation (mobile)',
      open: 'Open menu',
      close: 'Close menu',
      call: `Call ${business.phone.display}`,
      whatsapp: 'Send a WhatsApp',
    }
  : {
      home: '/',
      homeLabel: `${business.name} – zur Startseite`,
      nav: 'Hauptnavigation',
      navMobile: 'Hauptnavigation mobil',
      open: 'Menü öffnen',
      close: 'Menü schließen',
      call: `${business.phone.display} anrufen`,
      whatsapp: 'WhatsApp schreiben',
    };
---

<header class="site-header bg-damask">
  <div class="container site-header__inner">
    <a href={t.home} class="site-header__brand" aria-label={t.homeLabel}>
      <Logo width={128} />
    </a>

    <nav class="site-nav" aria-label={t.nav}>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href, path) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn--gold site-header__call" href={telHref}>
      <Icon name="phone" />
      <span>{business.phone.display}</span>
    </a>

    <LanguageSwitch lang={lang} />

    <button class="menu-toggle" type="button" popovertarget="mobile-menu" aria-label={t.open}>
      <Icon name="menu" />
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu bg-damask" popover>
    <div class="mobile-menu__top">
      <Logo width={112} loading="lazy" />
      <div class="mobile-menu__actions">
        <LanguageSwitch lang={lang} />
        <button class="menu-toggle" type="button" popovertarget="mobile-menu" popovertargetaction="hide" aria-label={t.close}>
          <Icon name="close" />
        </button>
      </div>
    </div>
    <nav aria-label={t.navMobile}>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href, path) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mobile-menu__contact">
      <a class="btn btn--gold" href={telHref}><Icon name="phone" /> {t.call}</a>
      <a class="btn btn--outline-light" href={whatsappHref()}><Icon name="whatsapp" /> {t.whatsapp}</a>
      {hours && <p><Icon name="clock" /> {hours}</p>}
    </div>
  </div>
</header>

<script>
  // Menü nach einem Klick auf einen Link schließen; nötig für Sprungmarken auf derselben Seite (englische Seite)
  const menu = document.getElementById('mobile-menu');
  menu?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a') && menu.matches(':popover-open')) menu.hidePopover();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: 0 2px 0 var(--gold-600), 0 3px 0 var(--gold-300), 0 8px 24px -10px rgb(20 10 44 / 0.6);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--header-h);
  }

  .site-header__brand {
    display: block;
    flex: none;
    padding-block: 0.4rem;
  }

  .site-header__brand :global(.logo) {
    width: 112px;
  }

  @media (min-width: 64rem) {
    .site-header__brand :global(.logo) {
      width: 128px;
    }
  }

  .site-nav {
    display: none;
    margin-left: auto;
  }

  .site-nav ul {
    display: flex;
    gap: clamp(1rem, 2.2vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a,
  .mobile-menu nav a {
    position: relative;
    font-family: var(--font-caps);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--cream-100);
    text-decoration: none;
  }

  .site-nav a {
    display: block;
    padding: 0.5rem 0;
    font-size: 0.9375rem;
  }

  .site-nav a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.15rem;
    width: 0;
    height: 2px;
    background: var(--gold-rule);
    transition:
      width 0.2s ease,
      left 0.2s ease;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--gold-300);
  }

  .site-nav a:hover::after,
  .site-nav a[aria-current='page']::after {
    left: 0;
    width: 100%;
  }

  .site-header__call {
    display: none;
    --btn-pad-y: 0.6rem;
    --btn-pad-x: 1.1rem;
    min-height: 2.75rem;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  /* Sprachumschalter: mobil links neben dem Menüknopf, am Desktop ganz rechts */
  .site-header__inner > :global(.lang-switch) {
    margin-left: auto;
  }

  .menu-toggle {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 1px solid rgb(247 215 116 / 0.55);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.05);
    color: var(--gold-300);
    cursor: pointer;
  }

  .menu-toggle :global(.icon) {
    width: 1.5rem;
    height: 1.5rem;
  }

  @media (min-width: 64rem) {
    .site-nav,
    .site-header__call {
      display: flex;
    }

    .site-header__inner > :global(.lang-switch) {
      margin-left: 0;
    }

    .site-header > .site-header__inner > .menu-toggle {
      display: none;
    }
  }

  /* Mobiles Menü (Popover-API, ohne JavaScript) */
  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter) 2rem;
    border: 0;
    overflow-y: auto;
    flex-direction: column;
  }

  .mobile-menu:popover-open {
    display: flex;
  }

  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
    border-bottom: 1px solid rgb(247 215 116 / 0.3);
  }

  .mobile-menu__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .mobile-menu nav ul {
    margin: 1.5rem 0;
    padding: 0;
    list-style: none;
  }

  .mobile-menu nav a {
    display: block;
    padding: 0.9rem 0;
    font-size: 1.4rem;
    border-bottom: 1px solid rgb(247 215 116 / 0.15);
  }

  .mobile-menu nav a[aria-current='page'] {
    color: var(--gold-300);
  }

  .mobile-menu__contact {
    display: grid;
    gap: 0.75rem;
    margin-top: auto;
  }

  .mobile-menu__contact p {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    color: var(--cream-200);
  }

  .mobile-menu__contact p :global(.icon) {
    color: var(--gold-300);
  }
</style>
