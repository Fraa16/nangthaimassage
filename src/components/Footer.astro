---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import LatticeBand from './LatticeBand.astro';
import { business, dailyHours, formatTime12, fullAddress, hoursSummary, hoursSummaryEn } from '../data/business';
import { mainNav, mainNavEn, legalNav, englishHref } from '../data/navigation';
import { services } from '../data/services';
import { telHref, whatsappHref, directionsUrl, googleMapsUrl } from '../lib/links';

interface Props {
  lang?: 'de' | 'en';
}

const { lang = 'de' } = Astro.props;
const en = lang === 'en';
const year = new Date().getFullYear();
const daily = dailyHours();
const hours = en ? hoursSummaryEn() : hoursSummary();
const t = en
  ? {
      about: `${business.name} is a studio for traditional Thai massage in ${business.address.city}, district of Böblingen. Professional massages in the Thai tradition, ${hours ? hours.replace('Daily', 'daily') : 'appointments by arrangement'}.`,
      contact: 'Contact',
      reviews: 'Reviews on Google',
      hoursTitle: 'Opening hours',
      days: 'Monday to Sunday',
      time: daily ? `${formatTime12(daily.opens)} – ${formatTime12(daily.closes)}` : '',
      holidays: 'including public holidays',
      note: business.byAppointment ? 'Appointments by phone or WhatsApp, other times by arrangement.' : 'Appointments by phone or WhatsApp.',
      massages: 'Massages',
      pages: 'Pages',
      legal: 'Legal (in German)',
      nav: mainNavEn,
      massageHref: (slug: string) => `/en/#${slug}`,
      switchLink: { href: '/', lang: 'de', label: 'Deutsch' },
    }
  : {
      about: `${business.name} ist ein Studio für traditionelle Thaimassage in ${business.address.city}, ${business.address.district}. Seriöse Massagen nach thailändischer Tradition, ${hours ? hours.replace('Täglich', 'täglich') : 'Termine nach Vereinbarung'}.`,
      contact: 'Kontakt',
      reviews: 'Bewertungen auf Google',
      hoursTitle: 'Öffnungszeiten',
      days: 'Montag bis Sonntag',
      time: daily ? `${daily.opens} – ${daily.closes} Uhr` : '',
      holidays: 'auch an Feiertagen',
      note: business.byAppointment ? 'Termine per Anruf oder WhatsApp, auch nach Vereinbarung.' : 'Termine per Anruf oder WhatsApp.',
      massages: 'Massagen',
      pages: 'Seiten',
      legal: 'Rechtliches',
      nav: mainNav,
      massageHref: (slug: string) => `/leistungen/#${slug}`,
      switchLink: { href: englishHref(Astro.url.pathname), lang: 'en', label: 'English' },
    };
---

<footer class="site-footer">
  <LatticeBand />
  <div class="bg-damask site-footer__main">
    <div class="container site-footer__grid">
      <div class="site-footer__brand">
        <Logo width={168} loading="lazy" />
        <p>{t.about}</p>
      </div>

      <div>
        <h2 class="site-footer__title">{t.contact}</h2>
        <address>
          <ul class="site-footer__list">
            <li>
              <Icon name="map-pin" />
              <a href={directionsUrl} rel="noopener" target="_blank">{fullAddress}</a>
            </li>
            <li>
              <Icon name="phone" />
              <a href={telHref}>{business.phone.display}</a>
            </li>
            <li>
              <Icon name="whatsapp" />
              <a href={whatsappHref()} rel="noopener" target="_blank">WhatsApp</a>
            </li>
            <li>
              <Icon name="star" />
              <a href={googleMapsUrl} rel="noopener" target="_blank">{t.reviews}</a>
            </li>
          </ul>
        </address>
      </div>

      <div>
        <h2 class="site-footer__title">{t.hoursTitle}</h2>
        {
          daily ? (
            <p class="site-footer__hours">
              <Icon name="clock" />
              <span>
                {t.days}
                <br />
                {t.time}
                {business.openOnHolidays && (
                  <>
                    <br />
                    {t.holidays}
                  </>
                )}
              </span>
            </p>
          ) : (
            <ul class="site-footer__list">
              {business.openingHours.map((d) => (
                <li>
                  {en ? d.schemaDay : d.day}: {d.opens}–{d.closes}
                  {en ? '' : ' Uhr'}
                </li>
              ))}
            </ul>
          )
        }
        <p class="site-footer__note">{t.note}</p>
      </div>

      <nav aria-label={t.massages}>
        <h2 class="site-footer__title">{t.massages}</h2>
        <ul class="site-footer__links">
          {
            services.map((s) => (
              <li>
                <a href={t.massageHref(s.slug)}>{en ? s.en.name : s.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="container site-footer__bottom">
      <p>© {year} {business.name}</p>
      <nav aria-label={t.pages}>
        <ul class="site-footer__inline">
          {
            t.nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
          <li>
            <a class="site-footer__lang" href={t.switchLink.href} hreflang={t.switchLink.lang} lang={t.switchLink.lang}>
              {t.switchLink.label}
            </a>
          </li>
        </ul>
      </nav>
      <nav aria-label={t.legal}>
        <ul class="site-footer__inline">
          {
            legalNav.map((item) => (
              <li>
                <a href={item.href} hreflang={en ? 'de' : undefined} lang={en ? 'de' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer__main {
    padding-block: clamp(3rem, 6vw, 4.5rem) 1.5rem;
    font-size: 1rem;
  }

  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 40rem) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 64rem) {
    .site-footer__grid {
      grid-template-columns: 1.3fr 1fr 1fr 1fr;
      gap: 3rem;
    }
  }

  .site-footer__brand :global(.logo) {
    width: 168px;
    margin-bottom: 1.25rem;
  }

  .site-footer__brand p {
    max-width: 30ch;
  }

  .site-footer__title {
    margin-bottom: 1rem;
    font-family: var(--font-caps);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .site-footer__list,
  .site-footer__links,
  .site-footer__inline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__list li,
  .site-footer__hours {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    margin-bottom: 0.7rem;
  }

  .site-footer__list :global(.icon),
  .site-footer__hours :global(.icon) {
    margin-top: 0.2em;
    color: var(--gold-300);
  }

  .site-footer__links li {
    margin-bottom: 0.45rem;
  }

  .site-footer a {
    color: var(--cream-100);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--gold-300);
    text-decoration: underline;
  }

  .site-footer__note {
    font-size: 0.9375rem;
    color: var(--cream-200);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(247 215 116 / 0.25);
    font-size: 0.9375rem;
  }

  .site-footer__bottom p {
    margin: 0;
  }

  .site-footer__inline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .site-footer__lang {
    font-weight: 650;
  }
</style>
