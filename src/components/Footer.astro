---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import LatticeBand from './LatticeBand.astro';
import { business, fullAddress, hoursSummary } from '../data/business';
import { mainNav, legalNav } from '../data/navigation';
import { services } from '../data/services';
import { telHref, whatsappHref, directionsUrl, googleMapsUrl, hasEmail, mailHref } from '../lib/links';

const hours = hoursSummary();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <LatticeBand />
  <div class="bg-damask site-footer__main">
    <div class="container site-footer__grid">
      <div class="site-footer__brand">
        <Logo width={168} loading="lazy" />
        <p>
          {business.name} ist ein Studio für traditionelle Thaimassage in {business.address.city}, {business.address.district}.
          Seriöse Massagen nach thailändischer Tradition, {hours ? hours.replace('Täglich', 'täglich') : 'Termine nach Vereinbarung'}.
        </p>
      </div>

      <div>
        <h2 class="site-footer__title">Kontakt</h2>
        <address>
          <ul class="site-footer__list">
            <li>
              <Icon name="map-pin" />
              <a href={directionsUrl} rel="noopener" target="_blank">{fullAddress}</a>
            </li>
            <li>
              <Icon name="phone" />
              <a href={telHref}>{business.phone.display}</a>
            </li>
            <li>
              <Icon name="whatsapp" />
              <a href={whatsappHref()} rel="noopener" target="_blank">WhatsApp</a>
            </li>
            <li>
              <Icon name="star" />
              <a href={googleMapsUrl} rel="noopener" target="_blank">Bewertungen auf Google</a>
            </li>
            {
              hasEmail && (
                <li>
                  <Icon name="mail" />
                  <a href={mailHref}>{business.email}</a>
                </li>
              )
            }
          </ul>
        </address>
      </div>

      <div>
        <h2 class="site-footer__title">Öffnungszeiten</h2>
        {
          hours ? (
            <p class="site-footer__hours">
              <Icon name="clock" />
              <span>
                Montag bis Sonntag
                <br />
                {business.openingHours[0].opens} – {business.openingHours[0].closes} Uhr
              </span>
            </p>
          ) : (
            <ul class="site-footer__list">
              {business.openingHours.map((d) => (
                <li>
                  {d.day}: {d.opens}–{d.closes} Uhr
                </li>
              ))}
            </ul>
          )
        }
        <p class="site-footer__note">Termine per Anruf oder WhatsApp.</p>
      </div>

      <nav aria-label="Leistungen">
        <h2 class="site-footer__title">Massagen</h2>
        <ul class="site-footer__links">
          {
            services.map((s) => (
              <li>
                <a href={`/leistungen/#${s.slug}`}>{s.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="container site-footer__bottom">
      <p>© {year} {business.name}</p>
      <nav aria-label="Seiten">
        <ul class="site-footer__inline">
          {
            mainNav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label="Rechtliches">
        <ul class="site-footer__inline">
          {
            legalNav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer__main {
    padding-block: clamp(3rem, 6vw, 4.5rem) 1.5rem;
    font-size: 1rem;
  }

  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 40rem) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 64rem) {
    .site-footer__grid {
      grid-template-columns: 1.3fr 1fr 1fr 1fr;
      gap: 3rem;
    }
  }

  .site-footer__brand :global(.logo) {
    width: 168px;
    margin-bottom: 1.25rem;
  }

  .site-footer__brand p {
    max-width: 30ch;
  }

  .site-footer__title {
    margin-bottom: 1rem;
    font-family: var(--font-caps);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .site-footer__list,
  .site-footer__links,
  .site-footer__inline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__list li,
  .site-footer__hours {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    margin-bottom: 0.7rem;
  }

  .site-footer__list :global(.icon),
  .site-footer__hours :global(.icon) {
    margin-top: 0.2em;
    color: var(--gold-300);
  }

  .site-footer__links li {
    margin-bottom: 0.45rem;
  }

  .site-footer a {
    color: var(--cream-100);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--gold-300);
    text-decoration: underline;
  }

  .site-footer__note {
    font-size: 0.9375rem;
    color: var(--cream-200);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(247 215 116 / 0.25);
    font-size: 0.9375rem;
  }

  .site-footer__bottom p {
    margin: 0;
  }

  .site-footer__inline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
</style>
