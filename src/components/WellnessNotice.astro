---
/** „Gut zu wissen“ mit Wellness-Hinweis (Heilmittelwerbegesetz). */
interface Props {
  id?: string;
  /** Zusätzliche Hinweise, z. B. zur Kleidung */
  items?: string[];
  title?: string;
}

const { id = 'hinweis-title', items = [], title = 'ข้อควรทราบ' } = Astro.props;
const all = [
  ...items,
  'ควรมาถึงก่อนเวลานัดสักสองสามนาที จะได้ไม่ต้องรีบ',
  'กรุณาแจ้งล่วงหน้าหากคุณตั้งครรภ์ เพิ่งผ่าตัด หรือมีปัญหาสุขภาพ',
  'หากมาตามนัดไม่ได้ กรุณาแจ้งให้เราทราบทางโทรศัพท์หรือ WhatsApp',
];
---

<div class="notice">
  <h2 id={id}>{title}</h2>
  <ul>
    {all.map((item) => <li>{item}</li>)}
  </ul>
  <p class="notice__legal">
    {'การนวดของเราเป็นการนวดเพื่อสุขภาพและการผ่อนคลาย มีไว้เพื่อการพักผ่อนและความรู้สึกสบาย ไม่สามารถใช้แทนการรักษาทางการแพทย์หรือกายภาพบำบัดได้'}
  </p>
</div>

<style>
  .notice {
    padding: 2rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--purple-200);
    background: var(--purple-100);
  }

  .notice h2 {
    font-size: 1.9rem;
  }

  .notice li {
    margin-bottom: 0.5rem;
    color: var(--ink-700);
  }

  .notice__legal {
    margin: 1.25rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--purple-200);
    font-size: 0.9375rem;
    color: var(--ink-500);
  }
</style>
