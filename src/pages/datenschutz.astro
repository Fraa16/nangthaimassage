---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Placeholder from '../components/Placeholder.astro';
import { business, hosting } from '../data/business';
import { telHref } from '../lib/links';

const breadcrumbs = [{ name: 'ความเป็นส่วนตัว', href: '/datenschutz/' }];
---

<BaseLayout
  title="นโยบายความเป็นส่วนตัว"
  description={`นโยบายความเป็นส่วนตัวของ ${business.name}: ไม่มีคุกกี้ ไม่มีการติดตาม แผนที่ Google Maps โหลดเมื่อได้รับความยินยอมเท่านั้น`}
  breadcrumbs={breadcrumbs}
>
  <PageHero title="นโยบายความเป็นส่วนตัว" breadcrumbs={breadcrumbs} />

  <section class="section">
    <div class="container container--narrow prose">
      <h2>สรุปสาระสำคัญ</h2>
      <ul>
        <li>เว็บไซต์นี้ไม่ใช้คุกกี้ และไม่ใช้เครื่องมือวิเคราะห์หรือติดตามผู้ใช้</li>
        <li>ฟอนต์และรูปภาพเก็บไว้บนเซิร์ฟเวอร์ของเราเอง ไม่มีการเชื่อมต่อกับ Google Fonts</li>
        <li>แผนที่ Google Maps จะโหลดก็ต่อเมื่อคุณยินยอมอย่างชัดเจนเท่านั้น</li>
        <li>เมื่อคุณโทรหาเราหรือส่งข้อความ WhatsApp เราใช้ข้อมูลของคุณเพื่อการนัดหมายเท่านั้น</li>
      </ul>

      <h2>1. ผู้รับผิดชอบ</h2>
      <p>
        {'ผู้รับผิดชอบการประมวลผลข้อมูลบนเว็บไซต์นี้คือ:'}
        <br />
        {`${business.name} เจ้าของร้าน: `}<Placeholder value={business.owner} />
        <br />
        {business.address.street}, {business.address.postalCode} {business.address.city}
        <br />
        {'โทรศัพท์: '}<a href={telHref}>{business.phone.display}</a>
      </p>

      <h2>2. การโฮสต์เว็บไซต์และไฟล์บันทึกของเซิร์ฟเวอร์</h2>
      <p>
        {`เว็บไซต์นี้โฮสต์อยู่ที่ ${hosting.name}, ${hosting.address} เมื่อมีการเปิดเว็บไซต์ ผู้ให้บริการโฮสต์จะประมวลผลข้อมูลที่เบราว์เซอร์ของคุณส่งมาโดยอัตโนมัติ (ไฟล์บันทึกของเซิร์ฟเวอร์):`}
      </p>
      <ul>
        <li>ที่อยู่ IP</li>
        <li>วันที่และเวลาที่เข้าชม</li>
        <li>หน้าที่เปิดและปริมาณข้อมูลที่ส่ง</li>
        <li>URL ที่มา (หน้าที่เข้าชมก่อนหน้า)</li>
        <li>ประเภทเบราว์เซอร์ ระบบปฏิบัติการ และประเภทอุปกรณ์</li>
      </ul>
      <p>
        {'ข้อมูลเหล่านี้จำเป็นทางเทคนิคเพื่อแสดงเว็บไซต์ และเพื่อความปลอดภัยและความเสถียรของเว็บไซต์ ฐานทางกฎหมายคือผลประโยชน์โดยชอบธรรมของเราตามมาตรา 6 วรรค 1 (f) GDPR (DSGVO) ข้อมูลบันทึกจะถูกลบหลังจากเวลาสั้น ๆ เว้นแต่จำเป็นต้องใช้ตรวจสอบเหตุการณ์ด้านความปลอดภัย'}
      </p>
      <p>
        {'เรามีสัญญาประมวลผลข้อมูลแทนกับผู้ให้บริการโฮสต์ตามมาตรา 28 GDPR ข้อมูลอาจถูกส่งไปยังสหรัฐอเมริกา การส่งข้อมูลอาศัยคำวินิจฉัยความเพียงพอของคณะกรรมาธิการยุโรปเรื่อง EU-US Data Privacy Framework และข้อสัญญามาตรฐาน (มาตรา 46 วรรค 2 (c) GDPR) ข้อมูลเพิ่มเติม: '}
        <a href={hosting.privacyUrl} rel="noopener" target="_blank">นโยบายความเป็นส่วนตัวของ Vercel</a>{' และ '}
        <a href={hosting.dpaUrl} rel="noopener" target="_blank">สัญญาประมวลผลข้อมูลของ Vercel</a>
      </p>

      <h2>3. การเข้ารหัส</h2>
      <p>
        {'เว็บไซต์นี้ส่งข้อมูลผ่านการเชื่อมต่อที่เข้ารหัสเท่านั้น (TLS สังเกตได้จาก „https://“) บุคคลอื่นจึงไม่สามารถอ่านข้อมูลที่ส่งได้'}
      </p>

      <h2>4. ไม่มีคุกกี้ ไม่มีการติดตาม</h2>
      <p>
        {'เราไม่ใช้คุกกี้ และไม่ใช้เครื่องมือวัดจำนวนผู้เข้าชมหรือโฆษณา ฟอนต์โหลดจากเซิร์ฟเวอร์ของเราเอง จึงไม่มีการส่งข้อมูลให้บุคคลอื่น'}
      </p>

      <h2>5. การติดต่อเรา</h2>
      <p>
        {'เมื่อคุณโทรหาเรา ส่งข้อความ WhatsApp หรือติดต่อด้วยวิธีอื่น เราจะประมวลผลข้อมูลของคุณ (เช่น ชื่อ เบอร์โทรศัพท์ เวลานัดที่ต้องการ และข้อความ) เพื่อตอบคำถามและนัดเวลาให้คุณ ฐานทางกฎหมายคือมาตรา 6 วรรค 1 (b) GDPR (การเตรียมและการปฏิบัติตามสัญญา) และผลประโยชน์โดยชอบธรรมของเราในการตอบคำถาม (มาตรา 6 วรรค 1 (f) GDPR) เราจะลบข้อมูลเมื่อไม่จำเป็นอีกต่อไป และไม่มีหน้าที่ตามกฎหมายที่ต้องเก็บรักษาไว้'}
      </p>

      <h3>WhatsApp</h3>
      <p>
        {'เราใช้ WhatsApp ในการนัดหมาย ซึ่งเป็นบริการของ WhatsApp Ireland Limited, Merrion Road, Dublin 4, D04 X2K5, ไอร์แลนด์ เมื่อคุณติดต่อเราทาง WhatsApp บริษัท WhatsApp จะประมวลผลเบอร์โทรศัพท์ ข้อมูลเมตา และข้อความของคุณตามเงื่อนไขของบริษัทเอง เนื้อหาข้อความเข้ารหัสแบบต้นทางถึงปลายทาง ข้อมูลอาจถูกส่งไปยัง Meta Platforms Inc. ในสหรัฐอเมริกา ซึ่งได้รับการรับรองภายใต้ EU-US Data Privacy Framework รายละเอียดดูได้ที่ '}
        <a href="https://www.whatsapp.com/legal/privacy-policy-eea" rel="noopener" target="_blank">นโยบายความเป็นส่วนตัวของ WhatsApp</a>
        {' หากคุณไม่ต้องการใช้ WhatsApp โทรหาเราได้เลย'}
      </p>

      <h3>แบบฟอร์มขอนัดเวลา</h3>
      <p>
        {'แบบฟอร์มในหน้าติดต่อไม่ได้ส่งข้อมูลไปยังเซิร์ฟเวอร์ของเรา ข้อมูลที่คุณกรอกจะถูกรวมเป็นข้อความในเบราว์เซอร์ของคุณเท่านั้น เมื่อคุณกด „ส่งคำขอนัดทาง WhatsApp“ แอป WhatsApp จะเปิดพร้อมข้อความนี้ ซึ่งคุณยังแก้ไขหรือยกเลิกได้ก่อนส่ง หลังจากนั้นข้อมูลเกี่ยวกับ WhatsApp ด้านบนจะมีผลใช้'}
      </p>

      <h2 id="google-maps">6. Google Maps</h2>
      <p>
        {'ในหน้าติดต่อ คุณสามารถเปิดแสดงแผนที่ Google Maps ได้ ผู้ให้บริการคือ Google Ireland Limited, Gordon House, Barrow Street, Dublin 4, ไอร์แลนด์ แผนที่จะโหลดก็ต่อเมื่อคุณกด „โหลดแผนที่ Google Maps“ เมื่อโหลดแล้ว ที่อยู่ IP และข้อมูลเกี่ยวกับเบราว์เซอร์ของคุณจะถูกส่งไปยัง Google และ Google อาจตั้งค่าคุกกี้ด้วย ข้อมูลอาจถูกส่งไปยัง Google LLC ในสหรัฐอเมริกา ซึ่งได้รับการรับรองภายใต้ EU-US Data Privacy Framework'}
      </p>
      <p>
        {'ฐานทางกฎหมายคือความยินยอมของคุณตามมาตรา 6 วรรค 1 (a) GDPR และมาตรา 25 วรรค 1 TDDDG ความยินยอมมีผลเฉพาะการเปิดหน้านั้นครั้งนั้น คุณเพิกถอนได้ทุกเมื่อด้วยการโหลดหน้าใหม่ ข้อมูลเพิ่มเติมดูได้ที่ '}
        <a href="https://policies.google.com/privacy" rel="noopener" target="_blank">นโยบายความเป็นส่วนตัวของ Google</a>
      </p>

      <h3>ลิงก์ไปยัง Google Maps และ Apple Maps</h3>
      <p>
        {'ลิงก์อย่าง „วางแผนเส้นทาง“ หรือ „รีวิวบน Google“ จะพาไปยัง Google Maps หรือโปรไฟล์ธุรกิจบน Google ของเรา หรือไปยัง Apple Maps (Apple Distribution International Ltd., Hollyhill Industrial Estate, Hollyhill, Cork, ไอร์แลนด์) ข้อมูลจะถูกส่งก็ต่อเมื่อคุณคลิกลิงก์เหล่านั้น หลังจากนั้นนโยบายความเป็นส่วนตัวของผู้ให้บริการแต่ละรายจะมีผลใช้'}
      </p>

      <h2>7. สิทธิของคุณ</h2>
      <p>คุณมีสิทธิต่อไปนี้ได้ทุกเมื่อ:</p>
      <ul>
        <li>ขอทราบข้อมูลของคุณที่เราเก็บไว้ (มาตรา 15 GDPR)</li>
        <li>ขอแก้ไขข้อมูลที่ไม่ถูกต้อง (มาตรา 16 GDPR)</li>
        <li>ขอลบข้อมูล (มาตรา 17 GDPR) และขอจำกัดการประมวลผล (มาตรา 18 GDPR)</li>
        <li>ขอโอนย้ายข้อมูล (มาตรา 20 GDPR)</li>
        <li>เพิกถอนความยินยอมที่เคยให้ไว้ โดยมีผลในอนาคต (มาตรา 7 วรรค 3 GDPR)</li>
      </ul>
      <p>
        <strong>สิทธิในการคัดค้าน:</strong>
        {' หากเราประมวลผลข้อมูลโดยอาศัยผลประโยชน์โดยชอบธรรม (มาตรา 6 วรรค 1 (f) GDPR) คุณคัดค้านการประมวลผลนั้นได้ทุกเมื่อ ด้วยเหตุผลที่เกิดจากสถานการณ์เฉพาะของคุณ (มาตรา 21 GDPR)'}
      </p>
      <p>
        {'สำหรับเรื่องทั้งหมดนี้ ส่งข้อความถึงเราตามข้อมูลติดต่อด้านบนได้เลย ไม่ต้องมีรูปแบบพิเศษ นอกจากนี้คุณยังร้องเรียนต่อหน่วยงานกำกับดูแลด้านการคุ้มครองข้อมูลได้ (มาตรา 77 GDPR) หน่วยงานที่รับผิดชอบเราคือ ผู้ตรวจการด้านการคุ้มครองข้อมูลและเสรีภาพด้านข้อมูลข่าวสารของรัฐบาเดิน-เวือร์ทเทมแบร์ก ('}<a href="https://www.baden-wuerttemberg.datenschutz.de" rel="noopener" target="_blank">www.baden-wuerttemberg.datenschutz.de</a>)
      </p>

      <h2>8. การตัดสินใจโดยอัตโนมัติ</h2>
      <p>ไม่มีการตัดสินใจโดยอัตโนมัติ รวมถึงการจัดทำโปรไฟล์</p>

      <p class="updated">ข้อมูล ณ กันยายน 2026</p>
    </div>
  </section>
</BaseLayout>

<style>
  .updated {
    margin-top: 3rem;
    font-size: 0.9375rem;
    color: var(--ink-500);
  }
</style>
