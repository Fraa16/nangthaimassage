---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Ornament from '../components/Ornament.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import FocusSection from '../components/FocusSection.astro';
import { business, hoursSummary, fullAddress } from '../data/business';
import { services, formatPrice, lowestPrice } from '../data/services';
import { about, yearsOfExperience } from '../data/about';

const hours = hoursSummary();
const breadcrumbs = [{ name: 'เกี่ยวกับเรา', href: '/ueber-uns/' }];

const values = [
  {
    icon: 'star',
    title: 'ประเพณีไทย',
    text: 'นวดแผนไทย ประคบสมุนไพร และนวดเท้ากดจุดสะท้อน: เทคนิคจากประเพณีการนวดไทยที่สืบทอดมาหลายร้อยปี',
  },
  {
    icon: 'award',
    title: `ประสบการณ์ ${yearsOfExperience} ปี`,
    text: 'Nang รู้จักกล้ามเนื้อ เส้นเอ็น และจุดกดเป็นอย่างดี เธอนวดตรงจุดด้วยน้ำหนักมือที่คุณรู้สึกสบาย',
  },
  {
    icon: 'clock',
    title: 'เปิดทุกวัน',
    text: `${hours ? hours.replace('ทุกวัน ', 'วันจันทร์ถึงวันอาทิตย์ ') : 'ตามนัดหมาย'} เปิดวันเสาร์ วันอาทิตย์${business.openOnHolidays ? ' และวันหยุดนักขัตฤกษ์' : ''}ด้วย ในวันที่ร้านอื่นปิด`,
  },
  {
    icon: 'map-pin',
    title: 'สุภาพและเป็นกันเอง',
    text: 'เฉพาะการนวดเพื่อสุขภาพแบบคลาสสิก ในบรรยากาศที่สงบ ใจกลาง Ehningen',
  },
] as const;

const steps = [
  {
    title: 'นัดเวลา',
    text: `โทรหรือส่ง WhatsApp มาที่ ${business.phone.display} บอกประเภทการนวด ระยะเวลา และเวลาที่ต้องการ`,
  },
  {
    title: 'มาถึงร้าน',
    text: `มาถึงที่ ${business.address.street} ก่อนเวลาสักสองสามนาที เราจะคุยกันสั้น ๆ ว่าคุณต้องการอะไร`,
  },
  {
    title: 'เพลิดเพลินกับการนวด',
    text: 'คุณผ่อนคลาย เรานวด ถ้าน้ำหนักมือแรงหรือเบาเกินไป บอกได้เลย',
  },
  {
    title: 'กลับบ้านอย่างสบายใจ',
    text: 'ชำระเงินที่ร้าน และนัดครั้งต่อไปไว้ได้เลย',
  },
];
---

<BaseLayout
  title="เกี่ยวกับเรา"
  fullTitle={`เกี่ยวกับเรา | ${business.name} ใน Ehningen`}
  description={`Nang นวดตามแบบไทยดั้งเดิมมาแล้ว ${yearsOfExperience} ปี ความถนัด: ${about.focusAreas.join(' ')} การนวดที่สุภาพใน Ehningen เปิด${hours ?? 'ตามนัดหมาย'}`}
  breadcrumbs={breadcrumbs}
>
  <PageHero
    eyebrow="เกี่ยวกับเรา"
    title="ประเพณีไทย <span class='accent'>ใจกลาง Ehningen</span>"
    lead={`Nang นวดตามแบบไทยดั้งเดิมมาแล้ว ${yearsOfExperience} ปี ความถนัดของเธอคือ ${about.focusAreas.slice(0, -1).join(' ')} และ${about.focusAreas.at(-1)}`}
    breadcrumbs={breadcrumbs}
  />

  <section class="section" aria-labelledby="studio-title">
    <div class="container intro">
      <div class="intro__text">
        <p class="eyebrow">ร้านของเรา</p>
        <h2 id="studio-title">Nang Thai Massage ใน Ehningen</h2>
        <p class="lead">
          {`${business.name} คือร้านนวดแผนไทยแบบดั้งเดิม ตั้งอยู่ที่ ${business.address.street} ใน ${business.address.city} ${business.address.district}`}
        </p>
        <p>
          {'เรามีการนวด 5 แบบตามแบบไทยดั้งเดิม ได้แก่ นวดแผนไทยแบบคลาสสิก นวดน้ำมันแบบไทย นวดหลัง คอ และบ่าไหล่ นวดประคบสมุนไพร และนวดเท้ากดจุดสะท้อน ใช้เวลา 30 ถึง 120 นาทีแล้วแต่ประเภทการนวด'}
        </p>
        <p>
          {`เดินทางมาจาก ${business.nearbyTowns.slice(0, 3).join(' ')} และ ${business.nearbyTowns[3]} ได้สะดวก ไม่ว่าจะเป็นการพักสั้น ๆ ช่วงกลางวัน หรือการพักผ่อนยาว ๆ ในวันหยุด คุณเลือกการนวดและระยะเวลาที่เหมาะกับวันของคุณได้เอง`}
        </p>
      </div>
      <aside class="intro__card" aria-label="ข้อมูลร้านโดยสรุป">
        <Ornament size={48} lines={false} />
        <dl>
          <div>
            <dt>ที่อยู่</dt>
            <dd>{fullAddress}</dd>
          </div>
          <div>
            <dt>ประสบการณ์</dt>
            <dd>{`${yearsOfExperience} ปี`}</dd>
          </div>
          <div>
            <dt>เวลาเปิด</dt>
            <dd>{hours ? `${hours}${business.openOnHolidays ? ' รวมถึงวันหยุดนักขัตฤกษ์' : ''}` : 'ตามนัดหมาย'}</dd>
          </div>
          <div>
            <dt>การนวด</dt>
            <dd>{`${services.length} แบบคลาสสิก`}</dd>
          </div>
          <div>
            <dt>ราคา</dt>
            <dd>{`เริ่มต้น ${formatPrice(lowestPrice)} สำหรับ 30 นาที`}</dd>
          </div>
          <div>
            <dt>นัดเวลา</dt>
            <dd>{`${business.phone.display} หรือทาง WhatsApp`}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <FocusSection detailed id="schwerpunkt" class="section--tint" />

  {
    about.story.length > 0 && (
      <section class="section" aria-labelledby="story-title">
        <div class="container container--narrow prose story">
          <Ornament size={36} />
          <h2 id="story-title">{about.storyTitle || 'ผู้หญิงเบื้องหลัง Nang'}</h2>
          {about.story.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </section>
    )
  }

  <section class:list={['section', { 'section--tint': about.story.length > 0 }]} aria-labelledby="werte-title">
    <div class="container">
      <SectionHeading id="werte-title" eyebrow="สิ่งที่เรายึดถือ" title="สิ่งที่คุณจะได้รับจากเรา" />
      <ul class="values">
        {
          values.map((v) => (
            <li>
              <span class="values__icon">
                <Icon name={v.icon} />
              </span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class:list={['section', { 'section--tint': about.story.length === 0 }]} aria-labelledby="ablauf-title">
    <div class="container">
      <SectionHeading id="ablauf-title" eyebrow="การมาใช้บริการ" title="ขั้นตอนเมื่อคุณมานวด" />
      <ol class="steps">
        {
          steps.map((step, i) => (
            <li>
              <span class="steps__number" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 60rem) {
    .intro {
      grid-template-columns: 1.5fr 1fr;
      gap: 4rem;
    }
  }

  .intro__text p:not(.lead):not(.eyebrow) {
    color: var(--ink-700);
  }

  .intro__card {
    padding: 2rem 1.75rem 1.25rem;
    border: 6px solid var(--purple-700);
    border-radius: 6px;
    outline: 2px solid var(--gold-500);
    outline-offset: -12px;
    background: var(--cream-50);
    box-shadow: var(--shadow);
  }

  .intro__card dl {
    margin-top: 1rem;
  }

  .intro__card dl div {
    padding: 0.7rem 0.5rem;
    border-top: 1px solid var(--cream-300);
  }

  .intro__card dt {
    font-family: var(--font-caps);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-700);
  }

  .intro__card dd {
    font-weight: 650;
    color: var(--purple-800);
  }

  .story {
    margin-inline: auto;
    text-align: center;
  }

  .values {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .values {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .values {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .values li {
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--cream-300);
    border-top: 3px solid var(--gold-500);
    border-radius: var(--radius);
    background: var(--cream-50);
    box-shadow: var(--shadow-sm);
  }

  .values__icon {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.85rem;
    border-radius: 50%;
    background: var(--purple-700);
    color: var(--gold-300);
  }

  .values h3 {
    font-size: 1.45rem;
  }

  .values p {
    margin: 0;
    color: var(--ink-700);
  }

  .steps {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  @media (min-width: 40rem) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .steps li {
    position: relative;
    padding-top: 0.5rem;
  }

  .steps__number {
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    background: linear-gradient(180deg, #f2c85a, #b27a14);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .steps h3 {
    font-size: 1.45rem;
  }

  .steps p {
    margin: 0;
    color: var(--ink-700);
  }
</style>
