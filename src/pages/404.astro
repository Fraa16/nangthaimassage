---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/business';
import { telHref } from '../lib/links';
---

<BaseLayout title="ไม่พบหน้านี้" description="ขออภัย ไม่มีหน้านี้" noindex>
  <PageHero
    eyebrow="ข้อผิดพลาด 404"
    title="ไม่มีหน้านี้"
    lead="ที่อยู่หน้าอาจเปลี่ยนไปแล้ว ไปต่อได้ที่นี่:"
  >
    <div class="btn-row">
      <a class="btn btn--gold" href="/">ไปหน้าแรก</a>
      <a class="btn btn--outline-light" href="/leistungen/">บริการและราคา</a>
      <a class="btn btn--outline-light" href={telHref}><Icon name="phone" /> {business.phone.display}</a>
    </div>
  </PageHero>
</BaseLayout>
