---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Ornament from '../components/Ornament.astro';
import Icon from '../components/Icon.astro';
import PriceBox from '../components/PriceBox.astro';
import WellnessNotice from '../components/WellnessNotice.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { services, formatPrice, lowestPrice } from '../data/services';
import { getServiceDetail } from '../data/service-details';
import { faqSchema, serviceSchema } from '../lib/schema';

const site = Astro.site ?? new URL(Astro.url.origin);
const durations = [...new Set(services.flatMap((s) => s.options.map((o) => o.minutes)))].sort((a, b) => a - b);
const breadcrumbs = [{ name: 'Leistungen & Preise', href: '/leistungen/' }];
const sections = services.map((s) => ({ service: s, detail: getServiceDetail(s.slug) }));
const questions = sections.flatMap((x) => x.detail.faq);
const schema = [
  ...sections.map(({ service }) => serviceSchema(site, service, `/leistungen/#${service.slug}`, service.teaser)),
  faqSchema(questions),
];
---

<BaseLayout
  title="Leistungen & Preise: Thaimassage ab 30 €"
  description={`Thaimassage, Thai-Ölmassage, Rücken-Nacken-Schulter, Kräuterstempel und Fußmassage in Ehningen. 30 bis 120 Minuten, ab ${formatPrice(lowestPrice)}. Alle Preise auf einen Blick.`}
  breadcrumbs={breadcrumbs}
  schema={schema}
>
  <PageHero
    eyebrow="Leistungen & Preise"
    title="Massagen und Preise"
    lead="Fünf Massagen nach thailändischer Tradition, von 30 Minuten für zwischendurch bis zur zweistündigen Auszeit. Alle Preise sind Endpreise, bezahlt wird vor Ort."
    breadcrumbs={breadcrumbs}
  />

  <section class="section" aria-labelledby="preisliste-title">
    <div class="container">
      <SectionHeading id="preisliste-title" eyebrow="Preisliste" title="Alle Preise auf einen Blick" />
      <div class="price-table-wrap" role="region" aria-label="Preistabelle" tabindex="0">
        <table class="price-table">
          <caption class="visually-hidden">Preise nach Massage und Dauer in Euro</caption>
          <thead>
            <tr>
              <th scope="col">Massage</th>
              {durations.map((d) => <th scope="col">{d} Min.</th>)}
            </tr>
          </thead>
          <tbody>
            {
              services.map((s) => (
                <tr>
                  <th scope="row">
                    <a href={`#${s.slug}`}>{s.name}</a>
                  </th>
                  {durations.map((d) => {
                    const option = s.options.find((o) => o.minutes === d);
                    return option ? (
                      <td>{formatPrice(option.price)}</td>
                    ) : (
                      <td class="price-table__empty">
                        <span aria-hidden="true">–</span>
                        <span class="visually-hidden">nicht angeboten</span>
                      </td>
                    );
                  })}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="price-note">Alle Preise in Euro, inklusive aller Abgaben. Bezahlt wird vor Ort beim Termin.</p>
    </div>
  </section>

  <div class="service-list">
    {
      sections.map(({ service: s, detail }, i) => (
        <section id={s.slug} class:list={['section', 'service', { 'section--tint': i % 2 === 0 }]} aria-labelledby={`${s.slug}-title`}>
          <div class="container service__grid">
            <div class="service__text">
              <Ornament size={30} lines={false} class="service__ornament" />
              <p class="eyebrow">{detail.eyebrow}</p>
              <h2 id={`${s.slug}-title`}>{s.name}</h2>
              <p class="service__lead">{s.teaser}</p>
              <h3>{detail.howTitle}</h3>
              {detail.how.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              <h3>{detail.forWhomTitle}</h3>
              <p>{detail.forWhom}</p>
              {detail.notes.length > 0 && (
                <ul class="service__notes">
                  {detail.notes.map((note) => (
                    <li>
                      <Icon name="check" />
                      <span>{note}</span>
                    </li>
                  ))}
                </ul>
              )}
              {detail.links && (
                <ul class="service__links">
                  {detail.links.map((link) => (
                    <li>
                      <a class="text-link" href={link.href} {...(link.external ? { rel: 'noopener', target: '_blank' } : {})}>
                        {link.label} <Icon name="arrow-right" />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
            <PriceBox service={s} guide={detail.durationGuide} />
          </div>
        </section>
      ))
    }
  </div>

  <section class="section" aria-labelledby="fragen-title">
    <div class="container">
      <SectionHeading id="fragen-title" eyebrow="Häufige Fragen" title="Gut zu wissen über die Massagen" />
      <Faq items={questions} />
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="hinweis-title">
    <div class="container container--narrow">
      <WellnessNotice />
    </div>
  </section>

  <CtaBand title="Welche Massage darf es sein?" text="Sagen Sie uns Massage, Dauer und Wunschzeit. Unsicher, was passt? Wir beraten Sie gern am Telefon." />
</BaseLayout>

<style>
  /* ---------- Preistabelle ---------- */
  .price-table-wrap {
    /* Bezugsrahmen für die unsichtbaren Tabellen-Hinweise, sonst ragen sie aus dem Scrollbereich */
    position: relative;
    overflow-x: auto;
    border: 1px solid var(--cream-300);
    border-radius: var(--radius);
    background: var(--cream-50);
    box-shadow: var(--shadow-sm);
  }

  .price-table {
    min-width: 21rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 40rem) {
    .price-table th,
    .price-table td {
      padding: 0.7rem 0.4rem;
    }

    .price-table thead th {
      font-size: 0.6875rem;
      letter-spacing: 0.04em;
    }

    .price-table tbody th {
      padding-left: 0.75rem;
      font-size: 0.9375rem;
      hyphens: auto;
    }

    .price-table td {
      font-size: 1.1rem;
      white-space: nowrap;
    }
  }

  .price-table th,
  .price-table td {
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--cream-200);
    text-align: center;
  }

  .price-table thead th {
    background: var(--purple-700);
    color: var(--gold-200);
    font-family: var(--font-caps);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .price-table thead th:first-child,
  .price-table tbody th {
    text-align: left;
  }

  .price-table tbody th a {
    font-weight: 650;
    color: var(--purple-800);
    text-decoration: none;
  }

  .price-table tbody th a:hover {
    text-decoration: underline;
  }

  .price-table td {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--purple-700);
  }

  .price-table__empty {
    color: var(--cream-300) !important;
  }

  .price-table tbody tr:last-child > * {
    border-bottom: 0;
  }

  .price-table tbody tr:hover {
    background: var(--purple-100);
  }

  .price-note {
    margin-top: 1rem;
    font-size: 0.9375rem;
    text-align: center;
    color: var(--ink-500);
  }

  /* ---------- Einzelne Massagen ---------- */
  .service__grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 56rem) {
    .service__grid {
      grid-template-columns: 1.5fr 1fr;
      gap: 4rem;
    }
  }

  .service__text :global(.service__ornament) {
    justify-content: flex-start;
    margin-bottom: 0.75rem;
  }

  .service__text p {
    color: var(--ink-700);
  }

  .service__text .eyebrow {
    margin-bottom: 0.4rem;
  }

  .service__text .service__lead {
    font-size: 1.125rem;
    color: var(--ink-900);
  }

  .service__text h3 {
    margin: 1.5rem 0 0.4rem;
    font-size: 1.35rem;
  }

  .service__notes,
  .service__links {
    display: grid;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .service__notes li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    color: var(--ink-700);
  }

  .service__notes :global(.icon) {
    margin-top: 0.2em;
    color: var(--gold-600);
  }
</style>
