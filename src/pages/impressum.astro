---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Placeholder from '../components/Placeholder.astro';
import { business } from '../data/business';
import { telHref, hasEmail } from '../lib/links';

const breadcrumbs = [{ name: 'ข้อมูลผู้ให้บริการ (Impressum)', href: '/impressum/' }];
---

<BaseLayout
  title="ข้อมูลผู้ให้บริการ (Impressum)"
  description={`ข้อมูลผู้ให้บริการของ ${business.name}, ${business.address.street}, ${business.address.postalCode} ${business.address.city}`}
  breadcrumbs={breadcrumbs}
>
  <PageHero title="ข้อมูลผู้ให้บริการ (Impressum)" lead="ข้อมูลที่กฎหมายเยอรมันกำหนดให้ทุกเว็บไซต์ธุรกิจต้องแสดง" breadcrumbs={breadcrumbs} />

  <section class="section">
    <div class="container container--narrow prose">
      <h2>ข้อมูลตามมาตรา 5 DDG (กฎหมายบริการดิจิทัล)</h2>
      <p>
        {business.name}
        <br />
        {'เจ้าของร้าน: '}<Placeholder value={business.owner} />
        <br />
        {business.address.street}
        <br />
        {business.address.postalCode} {business.address.city}
        <br />
        ประเทศเยอรมนี
      </p>

      <h2>ติดต่อ</h2>
      <p>
        {'โทรศัพท์และ WhatsApp: '}<a href={telHref}>{business.phone.display}</a>
        <br />
        {'อีเมล: '}{hasEmail ? business.email : <Placeholder value={business.email} />}
      </p>
      <p>กรุณานัดเวลาทางโทรศัพท์หรือ WhatsApp</p>

      {
        business.vatId && (
          <>
            <h2>เลขประจำตัวผู้เสียภาษีมูลค่าเพิ่ม</h2>
            <p>
              เลขประจำตัวผู้เสียภาษีมูลค่าเพิ่มตามมาตรา 27a กฎหมายภาษีมูลค่าเพิ่ม:
              <br />
              {business.vatId}
            </p>
          </>
        )
      }

      <h2>ผู้รับผิดชอบเนื้อหาตามมาตรา 18 วรรค 2 MStV (สนธิสัญญาสื่อของรัฐ)</h2>
      <p>
        <Placeholder value={business.owner} />
        <br />
        {business.address.street}, {business.address.postalCode} {business.address.city}
      </p>

      <h2>การระงับข้อพิพาทกับผู้บริโภค</h2>
      <p>
        {'เราไม่ประสงค์และไม่มีหน้าที่ต้องเข้าร่วมกระบวนการระงับข้อพิพาทต่อหน่วยงานไกล่เกลี่ยข้อพิพาทผู้บริโภค'}
      </p>

      <h2>ความรับผิดชอบต่อลิงก์</h2>
      <p>
        {'เว็บไซต์นี้มีลิงก์ไปยังเว็บไซต์ของบุคคลอื่น เช่น Google Maps และ WhatsApp เราไม่มีอิทธิพลต่อเนื้อหาของเว็บไซต์เหล่านั้น ผู้ให้บริการแต่ละรายเป็นผู้รับผิดชอบเอง ในขณะที่ใส่ลิงก์ไม่พบการกระทำผิดกฎหมาย หากเราทราบว่ามีการละเมิดกฎหมาย เราจะลบลิงก์นั้นทันที'}
      </p>

      <h2>หมายเหตุเกี่ยวกับการนวด</h2>
      <p>
        {'การนวดที่ให้บริการเป็นการนวดเพื่อสุขภาพและการผ่อนคลาย มีไว้เพื่อการพักผ่อนและความรู้สึกสบาย ไม่สามารถใช้แทนการรักษา การวินิจฉัยโรคทางการแพทย์ หรือกายภาพบำบัดได้'}
      </p>
    </div>
  </section>
</BaseLayout>
