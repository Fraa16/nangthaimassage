---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Ornament from '../components/Ornament.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Signboard from '../components/Signboard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import FocusSection from '../components/FocusSection.astro';
import Reviews from '../components/Reviews.astro';
import valance from '../assets/brand/valance.png';
import nang from '../assets/brand/logo-nang.png';
import { business, hoursSummary, hoursExtras } from '../data/business';
import { services, formatPrice, lowestPrice, getService } from '../data/services';
import { faq } from '../data/faq';
import { yearsOfExperience } from '../data/about';
import { unescoSource } from '../data/service-details';
import { faqSchema } from '../lib/schema';
import { telHref, whatsappHref, directionsUrl, googleMapsUrl } from '../lib/links';

const hours = hoursSummary();
const extras = hoursExtras();
const thai60 = getService('traditionelle-thaimassage').options.find((o) => o.minutes === 60);

const highlights = [
  {
    icon: 'clock',
    title: 'เปิดทุกวัน',
    text: `${hours ? hours.replace('ทุกวัน ', 'วันจันทร์ถึงวันอาทิตย์ ') : 'ตามนัดหมาย'}${extras ? ` ${extras}` : ''}`,
  },
  {
    icon: 'award',
    title: `ประสบการณ์ ${yearsOfExperience} ปี`,
    text: 'Nang รู้จักกล้ามเนื้อ เส้นเอ็น และจุดกดเป็นอย่างดี และหาจุดที่ตึงเจอ',
  },
  {
    icon: 'tag',
    title: 'ราคาชัดเจน',
    text: `30 นาทีเริ่มต้นที่ ${formatPrice(lowestPrice)}${thai60 ? ` นวดแผนไทยหนึ่งชั่วโมง ${formatPrice(thai60.price)}` : ''} ทุกราคาเป็นราคาสุทธิ`,
  },
  {
    icon: 'check',
    title: 'สุภาพและเป็นแบบดั้งเดิม',
    text: 'เฉพาะการนวดแบบคลาสสิกตามแบบไทยดั้งเดิม ในบรรยากาศที่สงบ',
  },
] as const;
---

<BaseLayout
  fullTitle={`นวดแผนไทยใน Ehningen | ${business.name}`}
  title="หน้าแรก"
  description={`นวดแผนไทยใน Ehningen ประสบการณ์ ${yearsOfExperience} ปี: แบบดั้งเดิม น้ำมันอุ่น ประคบสมุนไพร หรือนวดเท้ากดจุดสะท้อน เปิด${hours ?? ''} รวมถึงวันหยุดนักขัตฤกษ์ เริ่มต้น ${formatPrice(lowestPrice)}`}
  schema={[faqSchema(faq)]}
  alternates={[
    { hreflang: 'de', href: '/' },
    { hreflang: 'en', href: '/en/' },
    { hreflang: 'x-default', href: '/' },
  ]}
>
  <section class="hero bg-damask-light" aria-labelledby="hero-title">
    <Image
      src={valance}
      alt=""
      class="hero__valance"
      widths={[640, 960, 1280, 1600, 2000]}
      sizes="100vw"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
    />

    <div class="container hero__content">
      <div class="hero__logo" role="img" aria-label={business.name}>
        <Image
          src={nang}
          alt=""
          widths={[300, 460, 620, 760, 1140]}
          sizes="(min-width: 64rem) 340px, (min-width: 40rem) 300px, 230px"
          format="webp"
          quality={85}
          loading="eager"
        />
        <span aria-hidden="true">Thai Massage</span>
      </div>

      <h1 id="hero-title">นวดแผนไทยแบบดั้งเดิม <span class="hero__place">ใน Ehningen</span></h1>
      <p class="lead hero__lead">
        {`Nang นวดตามแบบไทยดั้งเดิมมาแล้ว ${yearsOfExperience} ปี: นวดแผนไทยแบบคลาสสิก นวดน้ำมัน ประคบสมุนไพร และนวดเท้ากดจุดสะท้อน ${hours ? `เปิด${hours} รวมถึงวันเสาร์ วันอาทิตย์ และวันหยุดนักขัตฤกษ์` : ''}`}
      </p>

      <div class="btn-row hero__actions">
        <a class="btn btn--gold" href={telHref}>
          <Icon name="phone" />
          {`โทรเลย: ${business.phone.display}`}
        </a>
        <a class="btn btn--outline" href={whatsappHref('สวัสดี ต้องการนัดเวลานวด')} rel="noopener" target="_blank">
          <Icon name="whatsapp" />
          สอบถามทาง WhatsApp
        </a>
      </div>

      <ul class="hero__facts">
        <li><Icon name="award" /> {`ประสบการณ์ ${yearsOfExperience} ปี`}</li>
        <li><Icon name="clock" /> {hours ?? 'ตามนัดหมาย'}</li>
        <li><Icon name="tag" /> {`เริ่มต้น ${formatPrice(lowestPrice)} สำหรับ 30 นาที`}</li>
        <li>
          <Icon name="map-pin" />
          <a href={directionsUrl} rel="noopener" target="_blank">{business.address.street}, {business.address.city}</a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section highlights" aria-labelledby="highlights-title">
    <div class="container">
      <h2 id="highlights-title" class="visually-hidden">ข้อมูลสำคัญโดยสรุป</h2>
      <ul class="highlights__list">
        {
          highlights.map((h) => (
            <li>
              <span class="highlights__icon">
                <Icon name={h.icon} />
              </span>
              <h3>{h.title}</h3>
              <p>{h.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <FocusSection class="section--tint" id="nangs-schwerpunkt" />
  <Reviews />

  <section class="section section--tint bg-damask-light" aria-labelledby="leistungen-title">
    <div class="container">
      <SectionHeading
        id="leistungen-title"
        eyebrow="บริการและราคา"
        title="การนวด 5 แบบ <span class='accent'>หนึ่งประเพณี</span>"
        lead="ตั้งแต่ 30 นาทีสำหรับพักระหว่างวัน ไปจนถึงการพักผ่อนสองชั่วโมง ทุกราคาเป็นราคาสุทธิ ชำระเงินที่ร้าน"
      />
      <ul class="services-grid">
        {
          services.map((service) => (
            <li>
              <ServiceCard service={service} />
            </li>
          ))
        }
      </ul>
      <p class="center-link">
        <a class="text-link" href="/leistungen/">ดูรายละเอียดบริการทั้งหมด <Icon name="arrow-right" /></a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="besuch-title">
    <div class="container">
      <SectionHeading
        id="besuch-title"
        eyebrow="การมาที่ร้าน"
        title="อยู่ใจกลาง Ehningen <span class='accent'>เปิดให้บริการทุกวัน</span>"
        lead={`ร้านตั้งอยู่ที่ ${business.address.street} เดินทางมาจาก ${business.nearbyTowns.slice(0, 4).join(' ')} และพื้นที่ใกล้เคียงได้สะดวก`}
      />
      <Signboard />
      <div class="btn-row besuch__actions">
        <a class="btn btn--purple" href={directionsUrl} rel="noopener" target="_blank"><Icon name="route" /> วางแผนเส้นทาง</a>
        <a class="btn btn--outline" href={googleMapsUrl} rel="noopener" target="_blank"><Icon name="star" /> รีวิวบน Google</a>
      </div>
    </div>
  </section>

  <section class="section section--tint thai" aria-labelledby="thai-title">
    <div class="container thai__grid">
      <div>
        <p class="eyebrow">นวดไทย (Nuad Thai)</p>
        <h2 id="thai-title">นวดแผนไทยแบบดั้งเดิมคืออะไร</h2>
        <p>
          {'นวดแผนไทยแบบดั้งเดิม ซึ่งในไทยเรียกว่า นวดไทย เป็นศาสตร์การนวดที่สืบทอดกันมาหลายร้อยปี ผสมผสานการกดเป็นจังหวะตามแนวเส้นพลังงานของร่างกายเข้ากับการยืดเหยียดโดยที่ผู้รับนวดไม่ต้องออกแรง ซึ่งคล้ายกับโยคะ ตามแบบดั้งเดิมจะนวดโดยไม่ใช้น้ำมันและสวมเสื้อผ้าที่สบาย'}
        </p>
        <p>
          {'ตามตำนานเล่าว่า การนวดไทยมีต้นกำเนิดมาจากหมอชีวกโกมารภัจจ์ แพทย์ในสมัยพุทธกาล ปัจจุบันยังคงมีการสอนในโรงเรียนนวดของวัด เช่น วัดโพธิ์ในกรุงเทพฯ ในปี 2019 องค์การยูเนสโกได้ขึ้นทะเบียนนวดไทยเป็นมรดกทางวัฒนธรรมที่จับต้องไม่ได้ของมนุษยชาติ ('}<a href={unescoSource} rel="noopener" target="_blank">มติของยูเนสโก ภาษาอังกฤษ</a>)
        </p>
        <a class="text-link" href="/leistungen/#traditionelle-thaimassage">ขั้นตอนและราคาของนวดแผนไทยแบบดั้งเดิม <Icon name="arrow-right" /></a>
      </div>
      <aside class="facts" aria-label="นวดแผนไทยโดยสรุป">
        <Ornament size={44} lines={false} />
        <h3>โดยสรุป</h3>
        <dl>
          <div><dt>ต้นกำเนิด</dt><dd>ประเทศไทย</dd></div>
          <div><dt>ชื่อภาษาไทย</dt><dd>นวดไทย, นวดแผนโบราณ</dd></div>
          <div><dt>เทคนิค</dt><dd>การกด การยืด การกดจุด</dd></div>
          <div><dt>มรดกทางวัฒนธรรม</dt><dd>ยูเนสโก ตั้งแต่ปี 2019</dd></div>
          <div><dt>ระยะเวลาที่ร้านเรา</dt><dd>30 ถึง 120 นาที</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <SectionHeading id="faq-title" eyebrow="คำถามที่พบบ่อย" title="ข้อควรทราบก่อนมานวด" />
      <Faq items={faq} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
    background:
      radial-gradient(60% 55% at 50% 42%, rgb(247 215 116 / 0.22), transparent 70%),
      var(--cream-100);
    text-align: center;
  }

  .hero :global(.hero__valance) {
    width: 100%;
    height: clamp(118px, 23.65vw, 473px);
    object-fit: cover;
    object-position: center top;
    filter: drop-shadow(0 10px 14px rgb(30 15 67 / 0.22));
  }

  .hero__content {
    margin-top: clamp(0.5rem, 2vw, 1.5rem);
  }

  .hero__logo {
    --logo-w: 230px;
    width: var(--logo-w);
    margin: 0 auto clamp(1.25rem, 3vw, 2rem);
  }

  .hero__logo :global(img) {
    width: 100%;
    filter: drop-shadow(0 4px 6px rgb(90 55 0 / 0.25));
  }

  .hero__logo span {
    display: block;
    margin-top: 0.1em;
    font-family: var(--font-caps);
    font-size: calc(var(--logo-w) * 0.075);
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    background: linear-gradient(180deg, #f7d774 0%, #d99f28 55%, #a8740f 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @media (min-width: 40rem) {
    .hero__logo {
      --logo-w: 300px;
    }
  }

  @media (min-width: 64rem) {
    .hero__logo {
      --logo-w: 340px;
    }
  }

  .hero h1 {
    margin-inline: auto;
  }

  .hero__place {
    display: block;
    font-style: italic;
    color: var(--gold-700);
  }

  .hero__lead {
    max-width: 38rem;
    margin-inline: auto;
  }

  .hero__actions {
    justify-content: center;
    margin-top: 1.75rem;
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 1rem;
    color: var(--ink-700);
  }

  .hero__facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero__facts :global(.icon) {
    color: var(--gold-600);
  }

  .hero__facts a {
    color: inherit;
  }

  /* ---------- Highlights ---------- */
  .highlights {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--cream-300);
  }

  .highlights__list {
    display: grid;
    gap: 2rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .highlights__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .highlights__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .highlights__icon {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.75rem;
    border-radius: 50%;
    background: var(--purple-700);
    color: var(--gold-300);
    box-shadow: 0 0 0 3px var(--cream-100), 0 0 0 4px var(--gold-500);
  }

  .highlights__icon :global(.icon-whatsapp) {
    color: #4ade80;
  }

  .highlights h3 {
    margin-bottom: 0.35rem;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .highlights p {
    margin: 0;
    color: var(--ink-700);
  }

  /* ---------- Leistungen ---------- */
  .services-grid {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 44rem) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 68rem) {
    .services-grid {
      grid-template-columns: repeat(6, 1fr);
    }

    .services-grid li {
      grid-column: span 2;
    }

    .services-grid li:nth-child(4) {
      grid-column: 2 / span 2;
    }
  }

  .center-link {
    margin: 2.25rem 0 0;
    text-align: center;
  }

  /* ---------- Besuch ---------- */
  .besuch__actions {
    justify-content: center;
    margin-top: 2rem;
  }

  /* ---------- Thaimassage ---------- */
  .thai__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 60rem) {
    .thai__grid {
      grid-template-columns: 1.5fr 1fr;
      gap: 4rem;
    }
  }

  .thai p {
    color: var(--ink-700);
  }

  .facts {
    padding: 2rem 1.75rem 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--cream-50);
    border: 1px solid var(--cream-300);
    box-shadow: var(--shadow-sm);
    text-align: center;
  }

  .facts h3 {
    margin: 0.75rem 0 1rem;
  }

  .facts dl {
    text-align: left;
  }

  .facts dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--cream-300);
  }

  .facts dt {
    color: var(--ink-500);
  }

  .facts dd {
    font-weight: 650;
    text-align: right;
    color: var(--purple-800);
  }
</style>
