---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Ornament from '../components/Ornament.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Signboard from '../components/Signboard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import FocusSection from '../components/FocusSection.astro';
import valance from '../assets/brand/valance.png';
import nang from '../assets/brand/logo-nang.png';
import { business, hoursSummary, hoursExtras } from '../data/business';
import { services, formatPrice, lowestPrice, getService } from '../data/services';
import { faq } from '../data/faq';
import { yearsOfExperience } from '../data/about';
import { faqSchema } from '../lib/schema';
import { telHref, whatsappHref, directionsUrl, googleMapsUrl } from '../lib/links';

const hours = hoursSummary();
const extras = hoursExtras();
const thai60 = getService('traditionelle-thaimassage').options.find((o) => o.minutes === 60);

const highlights = [
  {
    icon: 'clock',
    title: 'Täglich geöffnet',
    text: `${hours ? hours.replace('Täglich ', 'Montag bis Sonntag, ') : 'Termine nach Vereinbarung'}.${extras ? ` Ebenso ${extras.replace(/^auch /, '')}.` : ''}`,
  },
  {
    icon: 'award',
    title: `${yearsOfExperience} Jahre Erfahrung`,
    text: 'Nang kennt Muskeln, Sehnen und Druckpunkte genau und findet die Stellen, an denen es festsitzt.',
  },
  {
    icon: 'tag',
    title: 'Klare Preise',
    text: `30 Minuten ab ${formatPrice(lowestPrice)}${thai60 ? `, eine Stunde Thaimassage ${formatPrice(thai60.price)}` : ''}. Alle Preise sind Endpreise.`,
  },
  {
    icon: 'check',
    title: 'Seriös und traditionell',
    text: 'Ausschließlich klassische Massagen nach thailändischer Tradition, in ruhiger Atmosphäre.',
  },
] as const;
---

<BaseLayout
  fullTitle={`Thaimassage in Ehningen | ${business.name}`}
  title="Startseite"
  description={`Thaimassage in Ehningen mit ${yearsOfExperience} Jahren Erfahrung: traditionell, mit warmem Öl, Kräuterstempel oder Fußreflexzonen. ${hours ?? ''}, auch feiertags. Ab ${formatPrice(lowestPrice)}.`}
  schema={[faqSchema(faq)]}
>
  <section class="hero bg-damask-light" aria-labelledby="hero-title">
    <Image
      src={valance}
      alt=""
      class="hero__valance"
      widths={[640, 960, 1280, 1600, 2000]}
      sizes="100vw"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
    />

    <div class="container hero__content">
      <div class="hero__logo" role="img" aria-label={business.name}>
        <Image
          src={nang}
          alt=""
          widths={[300, 460, 620, 760, 1140]}
          sizes="(min-width: 64rem) 340px, (min-width: 40rem) 300px, 230px"
          format="webp"
          quality={85}
          loading="eager"
        />
        <span aria-hidden="true">Thai Massage</span>
      </div>

      <h1 id="hero-title">Traditionelle Thaimassage <span class="hero__place">in Ehningen</span></h1>
      <p class="lead hero__lead">
        {`Nang massiert seit ${yearsOfExperience} Jahren nach thailändischer Tradition: klassische Thaimassage, Ölmassage, Kräuterstempel und Fußreflexzonen. ${hours ? `${hours}, auch an Wochenenden und Feiertagen.` : ''}`}
      </p>

      <div class="btn-row hero__actions">
        <a class="btn btn--gold" href={telHref}>
          <Icon name="phone" />
          Jetzt anrufen: {business.phone.display}
        </a>
        <a class="btn btn--outline" href={whatsappHref('Hallo, ich möchte gern einen Termin vereinbaren.')} rel="noopener" target="_blank">
          <Icon name="whatsapp" />
          Per WhatsApp anfragen
        </a>
      </div>

      <ul class="hero__facts">
        <li><Icon name="award" /> {yearsOfExperience} Jahre Erfahrung</li>
        <li><Icon name="clock" /> {hours ?? 'Termine nach Vereinbarung'}</li>
        <li><Icon name="tag" /> Ab {formatPrice(lowestPrice)} für 30 Minuten</li>
        <li>
          <Icon name="map-pin" />
          <a href={directionsUrl} rel="noopener" target="_blank">{business.address.street}, {business.address.city}</a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section highlights" aria-labelledby="highlights-title">
    <div class="container">
      <h2 id="highlights-title" class="visually-hidden">Das Wichtigste auf einen Blick</h2>
      <ul class="highlights__list">
        {
          highlights.map((h) => (
            <li>
              <span class="highlights__icon">
                <Icon name={h.icon} />
              </span>
              <h3>{h.title}</h3>
              <p>{h.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <FocusSection class="section--tint" id="nangs-schwerpunkt" />

  <section class="section bg-damask-light" aria-labelledby="leistungen-title">
    <div class="container">
      <SectionHeading
        id="leistungen-title"
        eyebrow="Leistungen & Preise"
        title="Fünf Massagen, <span class='accent'>eine Tradition</span>"
        lead="Von 30 Minuten für zwischendurch bis zur zweistündigen Auszeit. Alle Preise sind Endpreise, bezahlt wird vor Ort."
      />
      <ul class="services-grid">
        {
          services.map((service) => (
            <li>
              <ServiceCard service={service} />
            </li>
          ))
        }
      </ul>
      <p class="center-link">
        <a class="text-link" href="/leistungen/">Alle Leistungen im Detail <Icon name="arrow-right" /></a>
      </p>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="besuch-title">
    <div class="container">
      <SectionHeading
        id="besuch-title"
        eyebrow="Ihr Besuch"
        title="Mitten in Ehningen, <span class='accent'>jeden Tag für Sie da</span>"
        lead={`Das Studio liegt in der ${business.address.street}. Aus ${business.nearbyTowns.slice(0, 4).join(', ')} und Umgebung ist es schnell zu erreichen.`}
      />
      <Signboard />
      <div class="btn-row besuch__actions">
        <a class="btn btn--purple" href={directionsUrl} rel="noopener" target="_blank"><Icon name="route" /> Route planen</a>
        <a class="btn btn--outline" href={googleMapsUrl} rel="noopener" target="_blank"><Icon name="star" /> Bewertungen auf Google</a>
      </div>
    </div>
  </section>

  <section class="section thai" aria-labelledby="thai-title">
    <div class="container thai__grid">
      <div>
        <p class="eyebrow">Nuad Thai</p>
        <h2 id="thai-title">Was ist traditionelle Thaimassage?</h2>
        <p>
          Die traditionelle Thaimassage, in Thailand Nuad Thai genannt, ist eine über Jahrhunderte überlieferte
          Massagetechnik. Sie verbindet rhythmischen Druck entlang der Energielinien des Körpers mit passiven Dehnungen,
          die an Yoga erinnern. Massiert wird traditionell ohne Öl und in bequemer Kleidung.
        </p>
        <p>
          Der Überlieferung nach geht sie auf Jivaka Kumar Bhaccha zurück, einen Arzt zur Zeit Buddhas. Gelehrt wird sie
          bis heute in Tempelschulen wie dem Wat Pho in Bangkok. 2019 hat die UNESCO Nuad Thai in die Liste des
          immateriellen Kulturerbes der Menschheit aufgenommen.
        </p>
        <a class="text-link" href="/leistungen/#traditionelle-thaimassage">Zur traditionellen Thaimassage <Icon name="arrow-right" /></a>
      </div>
      <aside class="facts" aria-label="Thaimassage auf einen Blick">
        <Ornament size={44} lines={false} />
        <h3>Auf einen Blick</h3>
        <dl>
          <div><dt>Herkunft</dt><dd>Thailand</dd></div>
          <div><dt>Thailändischer Name</dt><dd>Nuad Thai, Nuat Phaen Boran</dd></div>
          <div><dt>Technik</dt><dd>Druck, Dehnung, Akupressur</dd></div>
          <div><dt>Kulturerbe</dt><dd>UNESCO, seit 2019</dd></div>
          <div><dt>Dauer bei uns</dt><dd>30 bis 120 Minuten</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="faq-title">
    <div class="container">
      <SectionHeading id="faq-title" eyebrow="Häufige Fragen" title="Gut zu wissen vor Ihrem Termin" />
      <Faq items={faq} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
    background:
      radial-gradient(60% 55% at 50% 42%, rgb(247 215 116 / 0.22), transparent 70%),
      var(--cream-100);
    text-align: center;
  }

  .hero :global(.hero__valance) {
    width: 100%;
    height: clamp(118px, 23.65vw, 473px);
    object-fit: cover;
    object-position: center top;
    filter: drop-shadow(0 10px 14px rgb(30 15 67 / 0.22));
  }

  .hero__content {
    margin-top: clamp(0.5rem, 2vw, 1.5rem);
  }

  .hero__logo {
    --logo-w: 230px;
    width: var(--logo-w);
    margin: 0 auto clamp(1.25rem, 3vw, 2rem);
  }

  .hero__logo :global(img) {
    width: 100%;
    filter: drop-shadow(0 4px 6px rgb(90 55 0 / 0.25));
  }

  .hero__logo span {
    display: block;
    margin-top: 0.1em;
    font-family: var(--font-caps);
    font-size: calc(var(--logo-w) * 0.075);
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    background: linear-gradient(180deg, #f7d774 0%, #d99f28 55%, #a8740f 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @media (min-width: 40rem) {
    .hero__logo {
      --logo-w: 300px;
    }
  }

  @media (min-width: 64rem) {
    .hero__logo {
      --logo-w: 340px;
    }
  }

  .hero h1 {
    margin-inline: auto;
  }

  .hero__place {
    display: block;
    font-style: italic;
    color: var(--gold-700);
  }

  .hero__lead {
    max-width: 38rem;
    margin-inline: auto;
  }

  .hero__actions {
    justify-content: center;
    margin-top: 1.75rem;
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 1rem;
    color: var(--ink-700);
  }

  .hero__facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero__facts :global(.icon) {
    color: var(--gold-600);
  }

  .hero__facts a {
    color: inherit;
  }

  /* ---------- Highlights ---------- */
  .highlights {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--cream-300);
  }

  .highlights__list {
    display: grid;
    gap: 2rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .highlights__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .highlights__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .highlights__icon {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.75rem;
    border-radius: 50%;
    background: var(--purple-700);
    color: var(--gold-300);
    box-shadow: 0 0 0 3px var(--cream-100), 0 0 0 4px var(--gold-500);
  }

  .highlights__icon :global(.icon-whatsapp) {
    color: #4ade80;
  }

  .highlights h3 {
    margin-bottom: 0.35rem;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .highlights p {
    margin: 0;
    color: var(--ink-700);
  }

  /* ---------- Leistungen ---------- */
  .services-grid {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 44rem) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 68rem) {
    .services-grid {
      grid-template-columns: repeat(6, 1fr);
    }

    .services-grid li {
      grid-column: span 2;
    }

    .services-grid li:nth-child(4) {
      grid-column: 2 / span 2;
    }
  }

  .center-link {
    margin: 2.25rem 0 0;
    text-align: center;
  }

  /* ---------- Besuch ---------- */
  .besuch__actions {
    justify-content: center;
    margin-top: 2rem;
  }

  /* ---------- Thaimassage ---------- */
  .thai__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 60rem) {
    .thai__grid {
      grid-template-columns: 1.5fr 1fr;
      gap: 4rem;
    }
  }

  .thai p {
    color: var(--ink-700);
  }

  .facts {
    padding: 2rem 1.75rem 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--cream-50);
    border: 1px solid var(--cream-300);
    box-shadow: var(--shadow-sm);
    text-align: center;
  }

  .facts h3 {
    margin: 0.75rem 0 1rem;
  }

  .facts dl {
    text-align: left;
  }

  .facts dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--cream-300);
  }

  .facts dt {
    color: var(--ink-500);
  }

  .facts dd {
    font-weight: 650;
    text-align: right;
    color: var(--purple-800);
  }
</style>
