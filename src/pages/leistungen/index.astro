---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Ornament from '../../components/Ornament.astro';
import Icon from '../../components/Icon.astro';
import PriceBox from '../../components/PriceBox.astro';
import WellnessNotice from '../../components/WellnessNotice.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services, formatPrice, lowestPrice } from '../../data/services';

const durations = [...new Set(services.flatMap((s) => s.options.map((o) => o.minutes)))].sort((a, b) => a - b);
const breadcrumbs = [{ name: 'Leistungen & Preise', href: '/leistungen/' }];
const detailHref = (slug: string) => `/leistungen/${slug}/`;
---

<BaseLayout
  title="Leistungen & Preise: Thaimassage ab 30 €"
  description={`Thaimassage, Thai-Ölmassage, Rücken-Nacken-Schulter, Kräuterstempel und Fußmassage in Ehningen. 30 bis 120 Minuten, ab ${formatPrice(lowestPrice)}. Alle Preise auf einen Blick.`}
  breadcrumbs={breadcrumbs}
>
  <PageHero
    eyebrow="Leistungen & Preise"
    title="Massagen und Preise"
    lead="Fünf Massagen nach thailändischer Tradition, von 30 Minuten für zwischendurch bis zur zweistündigen Auszeit. Alle Preise sind Endpreise, bezahlt wird vor Ort."
    breadcrumbs={breadcrumbs}
  />

  <section class="section" aria-labelledby="preisliste-title">
    <div class="container">
      <SectionHeading id="preisliste-title" eyebrow="Preisliste" title="Alle Preise auf einen Blick" />
      <div class="price-table-wrap" role="region" aria-label="Preistabelle" tabindex="0">
        <table class="price-table">
          <caption class="visually-hidden">Preise nach Massage und Dauer in Euro</caption>
          <thead>
            <tr>
              <th scope="col">Massage</th>
              {durations.map((d) => <th scope="col">{d} Min.</th>)}
            </tr>
          </thead>
          <tbody>
            {
              services.map((s) => (
                <tr>
                  <th scope="row">
                    <a href={detailHref(s.slug)}>{s.name}</a>
                  </th>
                  {durations.map((d) => {
                    const option = s.options.find((o) => o.minutes === d);
                    return option ? (
                      <td>{formatPrice(option.price)}</td>
                    ) : (
                      <td class="price-table__empty">
                        <span aria-hidden="true">–</span>
                        <span class="visually-hidden">nicht angeboten</span>
                      </td>
                    );
                  })}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="price-note">Alle Preise in Euro, inklusive aller Abgaben. Bezahlt wird vor Ort beim Termin.</p>
    </div>
  </section>

  <div class="service-list">
    {
      services.map((s, i) => (
        <section id={s.slug} class:list={['section', 'service', { 'section--tint': i % 2 === 0 }]} aria-labelledby={`${s.slug}-title`}>
          <div class="container service__grid">
            <div class="service__text">
              <Ornament size={30} lines={false} class="service__ornament" />
              <h2 id={`${s.slug}-title`}>
                <a href={detailHref(s.slug)}>{s.name}</a>
              </h2>
              <p>{s.teaser}</p>
              <p class="service__suited">
                <Icon name="check" />
                <span>{s.suitedFor}</span>
              </p>
              <p class="service__more">
                <a class="text-link" href={detailHref(s.slug)} aria-label={`${s.name}: Ablauf, Dauer und Preise`}>
                  Ablauf, Dauer und Preise <Icon name="arrow-right" />
                </a>
              </p>
            </div>
            <PriceBox service={s} />
          </div>
        </section>
      ))
    }
  </div>

  <section class="section" aria-labelledby="hinweis-title">
    <div class="container container--narrow">
      <WellnessNotice />
    </div>
  </section>

  <CtaBand title="Welche Massage darf es sein?" text="Sagen Sie uns Massage, Dauer und Wunschzeit. Unsicher, was passt? Wir beraten Sie gern am Telefon." />
</BaseLayout>

<style>
  /* ---------- Preistabelle ---------- */
  .price-table-wrap {
    /* Bezugsrahmen für die unsichtbaren Tabellen-Hinweise, sonst ragen sie aus dem Scrollbereich */
    position: relative;
    overflow-x: auto;
    border: 1px solid var(--cream-300);
    border-radius: var(--radius);
    background: var(--cream-50);
    box-shadow: var(--shadow-sm);
  }

  .price-table {
    min-width: 21rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 40rem) {
    .price-table th,
    .price-table td {
      padding: 0.7rem 0.4rem;
    }

    .price-table thead th {
      font-size: 0.6875rem;
      letter-spacing: 0.04em;
    }

    .price-table tbody th {
      padding-left: 0.75rem;
      font-size: 0.9375rem;
      hyphens: auto;
    }

    .price-table td {
      font-size: 1.1rem;
      white-space: nowrap;
    }
  }

  .price-table th,
  .price-table td {
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--cream-200);
    text-align: center;
  }

  .price-table thead th {
    background: var(--purple-700);
    color: var(--gold-200);
    font-family: var(--font-caps);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .price-table thead th:first-child,
  .price-table tbody th {
    text-align: left;
  }

  .price-table tbody th a {
    font-weight: 650;
    color: var(--purple-800);
    text-decoration: none;
  }

  .price-table tbody th a:hover {
    text-decoration: underline;
  }

  .price-table td {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--purple-700);
  }

  .price-table__empty {
    color: var(--cream-300) !important;
  }

  .price-table tbody tr:last-child > * {
    border-bottom: 0;
  }

  .price-table tbody tr:hover {
    background: var(--purple-100);
  }

  .price-note {
    margin-top: 1rem;
    font-size: 0.9375rem;
    text-align: center;
    color: var(--ink-500);
  }

  /* ---------- Einzelne Massagen ---------- */
  .service__grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 56rem) {
    .service__grid {
      grid-template-columns: 1.5fr 1fr;
      gap: 4rem;
    }
  }

  .service__text :global(.service__ornament) {
    justify-content: flex-start;
    margin-bottom: 0.75rem;
  }

  .service__text p {
    color: var(--ink-700);
  }

  .service__more {
    margin-top: 1.25rem;
  }

  .service__text h2 a {
    color: inherit;
    text-decoration: none;
  }

  .service__text h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .service__suited {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin-top: 1.25rem;
    font-weight: 650;
    color: var(--purple-800) !important;
  }

  .service__suited :global(.icon) {
    margin-top: 0.2em;
    color: var(--gold-600);
  }
</style>
